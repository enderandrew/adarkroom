/* ---------------------------------------------------------------------------
 * Mobile stylesheet.
 *
 * Loaded ONLY by mobile.html, LAST, on top of the full desktop stylesheet set.
 *
 * This is an override layer, not a replacement. The desktop sheets supply
 * every visual detail -- animations, combat panels, glyph puzzles, the maze
 * renderer, the distress overlay -- and this file restates only what has to
 * change for a single-column touch layout. An earlier version loaded alone
 * and had to re-implement all of that; each omission surfaced as a bug
 * report, and the list never stopped growing.
 *
 * Because it loads last and unconditionally there are no media queries and no
 * specificity war -- ordinary rules win on source order. The single
 * !important in the file is for css/dark.css, which is injected at runtime
 * and so always lands after this one; see the note at that rule.
 *
 * Everything is a single column, full width, with generous tap targets.
 * ------------------------------------------------------------------------ */

:root {
	--ink: #000;
	--paper: #fff;
	--muted: #999;
	--line: #000;
	--tap: 48px;          /* minimum comfortable tap target */
}

* { box-sizing: border-box; }

/* ---------------------------------------------------------------------------
 * Dark mode.
 *
 * css/dark.css is still loaded and still does its job for desktop-shaped
 * selectors, but it hardcodes colours (body{color:#EEE}) while this layer
 * drives everything from --ink/--paper. Two independent colour sources can
 * disagree, and did: a white --paper background under dark.css's #EEE text is
 * the reported "labels missing or white on white".
 *
 * Flipping the variables instead means background and text can never come
 * from different places. One block re-themes the whole layer.
 *
 * The class sits on <html> beside mobileUI, set by MobileUI.applyDark() from
 * the same config.lightsOff key the desktop toggle uses. */
html.mobileUI.mDark {
	--ink: #eee;
	--paper: #272823;
	--muted: #777;
	--line: #eee;
}

/* Anything that could otherwise inherit a hardcoded colour from a desktop
 * sheet is pinned to the variables explicitly. */
html.mobileUI .button,
html.mobileUI .mSection,
html.mobileUI .mBody,
html.mobileUI #notifications,
html.mobileUI .eventPanel,
html.mobileUI #stores,
html.mobileUI #weapons,
html.mobileUI #village,
html.mobileUI #workers {
	color: var(--ink);
	background-color: var(--paper);
	border-color: var(--line);
}

html.mobileUI .button.disabled,
html.mobileUI .button.disabled:hover {
	color: var(--muted);
	border-color: var(--muted);
}

html.mobileUI, html.mobileUI body {
	/* main.css sets `body { display: flex; justify-content: center;
	 * align-items: center }` -- in a compound rule with .tooltip and
	 * select.menuBtn, which is why it is easy to miss. This layer never set
	 * `display`, so on mobile body stayed a CENTRING FLEX CONTAINER:
	 * #wrapper became a single shrink-to-fit, vertically centred flex item.
	 * That is the large empty bands above and below the content, and it
	 * stops the page growing downward normally as sections expand.
	 *
	 * Found from the DevTools cascade dump, not by reading the sheets. */
	display: block;
	margin: 0;
	padding: 0;
	/* Explicitly no decorative background.
	 *
	 * This page does not load css/main.css, so in principle the Logo0.png
	 * body background cannot reach it -- but a tiled wall of "A DARKER ROOM"
	 * behind an unusable page was the reported symptom of landing on the
	 * DESKTOP page by mistake, and if that ever happens again (a stale
	 * dist/, a partly-applied patch, a lang/*/main.css that grows a
	 * background rule) this makes the failure quiet rather than total. */
	/* See the dark-mode note above for why this one needs !important. */
	background-image: none !important;
	background: var(--paper);
	color: var(--ink);
	font-family: Raleway, "Times New Roman", Times, serif;
	font-size: 17px;
	line-height: 1.5;
	-webkit-text-size-adjust: 100%;
}

/* Dark mode is css/dark.css, injected by Engine.turnLightsOff().
 *
 * This page previously carried its own, because dark.css restyles selectors
 * that only main.css defines and dropped an unstyled logo onto the page. Both
 * of those stop being true now that the desktop sheets are loaded: dark.css
 * applies cleanly, and its logo rule carries its own no-repeat/size.
 *
 * The logo is still suppressed below -- it is decorative and there is no room
 * for it on a phone -- with the one !important in this file, because dark.css
 * is injected into <head> at RUNTIME and therefore always lands after this
 * stylesheet in source order. !important is the only thing that beats a later
 * rule of equal specificity, and it is scoped to a single property. */

html.mobileUI #wrapper {
	max-width: 700px;
	margin: 0 auto;
	padding: 12px 12px 40px 12px;
}

html.mobileUI #saveNotify {
	position: fixed;
	top: 8px;
	right: 8px;
	opacity: 0;
	z-index: 30;
	background: var(--paper);
	padding: 4px 8px;
	border: 1px solid var(--line);
}

/* --- location tabs ------------------------------------------------------ */

html.mobileUI #header {
	/* main.css pins this to height:20px with padding-bottom:20px, sized for
	 * a single row of desktop tabs. On a phone the location names are wider
	 * than the viewport, so they wrap and everything below the first 20px is
	 * clipped -- the half-visible "A Firelit Room / A Silent Forest" in the
	 * report. */
	height: auto;
	padding-bottom: 8px;
	margin-bottom: 12px;
	overflow-x: auto;
	white-space: nowrap;
	-webkit-overflow-scrolling: touch;
}

html.mobileUI #header .headerButton {
	display: inline-block;
	padding: 10px 14px;
	min-height: var(--tap);
	line-height: 28px;
	cursor: pointer;
	color: var(--muted);
}

html.mobileUI #header .headerButton.selected {
	color: var(--ink);
	text-decoration: underline;
}

/* The desktop slider machinery is meaningless in one column: panels are
   shown and hidden outright instead of being slid between. */
html.mobileUI #content, html.mobileUI #outerSlider, html.mobileUI #main, html.mobileUI #locationSlider {
	position: static;
	width: auto;
	height: auto;
	overflow: visible;
	transform: none;
	left: auto;
	top: auto;
}

html.mobileUI .location {
	position: static;
	float: none;
	width: auto;
}

/* --- collapsible sections ----------------------------------------------- */

html.mobileUI .mSection {
	display: flex;
	justify-content: space-between;
	align-items: center;
	border: 1px solid var(--line);
	padding: 0 14px;
	min-height: var(--tap);
	margin: 8px 0 0 0;
	cursor: pointer;
	font-weight: bold;
	user-select: none;
	-webkit-user-select: none;
	-webkit-tap-highlight-color: transparent;
}

html.mobileUI .mSectionMark::after { content: '\2212'; }        /* minus: open */
html.mobileUI .mSection.closed .mSectionMark::after { content: '+'; }

html.mobileUI .mBody {
	border: 1px solid var(--line);
	border-top: none;
	padding: 10px 14px;
	position: static;
	width: auto;
	top: auto;
	left: auto;
	right: auto;
}

html.mobileUI .mClosed { display: none; }

/* The stores/weapons boxes draw their own legend; the header above is that
   name already. */
html.mobileUI #stores::before, html.mobileUI #weapons::before { display: none; }

/* --- buttons ------------------------------------------------------------ */

html.mobileUI .button {
	display: block;
	/* !important is required, not preferred.
	 *
	 * lang/<x>/main.css forces .button{width:100px!important} and
	 * #outsidePanel .button{width:115px!important}, and those sheets are
	 * injected at runtime for any non-English language. Nothing but
	 * !important beats !important, and a fixed 100px button in a fluid
	 * column wraps its label onto two lines. */
	width: 100% !important;
	float: none;
	border: 1px solid var(--line);
	/* Padding alone gives the tap target.
	 *
	 * This was `min-height: var(--tap)` with `line-height: var(--tap)` (both
	 * 48px) and `overflow: hidden`. A label that wraps produces two 48px
	 * line boxes inside a 48px box and is clipped, and even unwrapped the
	 * combination leaves nothing to fall back on if anything shifts. Plain
	 * padding cannot clip. */
	padding: 14px;
	margin: 0 0 8px 0;
	text-align: center;
	cursor: pointer;
	position: relative;
	/* Colour forced so the label cannot lose to a desktop rule whichever
	 * sheet loads last -- css/dark.css is injected at runtime. */
	color: var(--ink) !important;
	background-color: var(--paper);
	-webkit-tap-highlight-color: transparent;
}

html.mobileUI .button:last-child { margin-bottom: 0; }

html.mobileUI .button.disabled { color: var(--muted); border-color: var(--muted); cursor: default; }

/* Cooldown fill, kept from the desktop design because it carries real
   information about when a button is usable again. */
html.mobileUI .button .cooldown {
	position: absolute;
	top: 0; left: 0; bottom: 0;
	background: rgba(0,0,0,0.12);
	z-index: -1;
}

/* Tooltips are hover-based and there is no hover on a touch screen. */
html.mobileUI .tooltip { display: none; }

/* --- rows (stores, workers, supplies) ----------------------------------- */

html.mobileUI .storeRow, html.mobileUI .rowKey, html.mobileUI .row {
	display: flex;
	justify-content: space-between;
	align-items: baseline;
	gap: 12px;
	padding: 4px 0;
}

html.mobileUI .row_key, html.mobileUI .row_val {
	float: none;
	clear: none;
}

html.mobileUI .row_key { text-align: left; }
html.mobileUI .row_val { text-align: right; white-space: nowrap; }

/* Worker up/down controls need to be tappable, not 10px arrows. */
html.mobileUI .upBtn, html.mobileUI .dnBtn, html.mobileUI .upManyBtn, html.mobileUI .dnManyBtn {
	display: inline-block;
	width: 34px;
	height: 34px;
	line-height: 34px;
	text-align: center;
	border: 1px solid var(--line);
	margin-left: 4px;
	cursor: pointer;
}

/* --- notifications ------------------------------------------------------ */

html.mobileUI #notifications {
	position: static;
	width: auto;
	height: 220px;
	max-height: 40vh;
	overflow-y: auto;
	-webkit-overflow-scrolling: touch;
	border: 1px solid var(--line);
	padding: 10px 14px;
	margin-top: 16px;
	-webkit-mask-image: none;
	mask-image: none;
}

html.mobileUI #notifications .notification {
	opacity: 1;
	margin-bottom: 8px;
}

html.mobileUI #notifyGradient { display: none; }

/* --- events ------------------------------------------------------------- */

html.mobileUI .eventPanel {
	position: fixed;
	top: 50%;
	left: 50%;
	transform: translate(-50%, -50%);
	width: calc(100vw - 24px);
	max-width: 560px;
	max-height: 85vh;
	overflow-y: auto;
	-webkit-overflow-scrolling: touch;
	background: var(--paper);
	border: 1px solid var(--line);
	padding: 16px;
	z-index: 40;
}

html.mobileUI .eventPanel .eventTitle {
	font-weight: bold;
	text-align: center;
	margin-bottom: 12px;
}

html.mobileUI #description { margin-bottom: 14px; }

/* --- combat ------------------------------------------------------------- */

html.mobileUI #fighterWrapper {
	display: flex;
	justify-content: space-between;
	gap: 16px;
	margin-bottom: 14px;
}

html.mobileUI .fighter { flex: 1 1 0; text-align: center; }

/* --- world map ---------------------------------------------------------- */

html.mobileUI #worldPanel { text-align: center; }

html.mobileUI #map {
	font-family: "Courier New", Courier, monospace;
	font-size: 11px;
	line-height: 11px;
	letter-spacing: 0;
	display: inline-block;
	white-space: pre;
	overflow: auto;
	max-width: 100%;
	-webkit-overflow-scrolling: touch;
}

html.mobileUI #worldPanel .row_key, html.mobileUI #worldPanel .row_val { display: inline-block; }

/* On-screen movement controls: a phone has no arrow keys, and swipe alone
   is easy to misfire when a wrong move costs supplies. */
html.mobileUI #mDpad {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 6px;
	max-width: 240px;
	margin: 14px auto 0 auto;
}

html.mobileUI #mDpad div {
	border: 1px solid var(--line);
	min-height: var(--tap);
	line-height: var(--tap);
	text-align: center;
	cursor: pointer;
	-webkit-tap-highlight-color: transparent;
}

html.mobileUI #mDpad .spacer { border: none; }

/* --- settings ----------------------------------------------------------- */

html.mobileUI #mSettingsBtn { margin-top: 20px; }

html.mobileUI #mSettingsPanel {
	border: 1px solid var(--line);
	border-top: none;
	padding: 6px 0;
}

/* The desktop menu is a fixed corner overlay. Here it is a plain list. */
html.mobileUI .mMenuList {
	position: static;
	display: block;
	max-width: none;
	text-align: left;
	white-space: normal;
	color: inherit;
}

html.mobileUI .mMenuList .menuBtn,
html.mobileUI .mMenuList span {
	display: block;
	padding: 0 14px;
	min-height: var(--tap);
	line-height: var(--tap);
	border-bottom: 1px solid #ddd;
	cursor: pointer;
}

html.mobileUI .mMenuList .menuBtn:last-child { border-bottom: none; }

/* The language picker's dropdown is absolutely positioned on desktop and
   anchors to the corner. In the list it is just another expanding row. */
html.mobileUI .mMenuList .customSelect {
	position: relative;
	width: auto;
	height: auto;
	padding: 0;
}

html.mobileUI .mMenuList .customSelectOptions,
html.mobileUI .mMenuList .customSelectOptions > ul {
	position: static;
	width: auto;
	max-height: none;
	overflow: visible;
	list-style: none;
	padding: 0;
	margin: 0;
}

html.mobileUI .mMenuList .customSelectOptions > ul > li {
	padding: 0 14px;
	min-height: var(--tap);
	line-height: var(--tap);
	border-bottom: 1px solid #ddd;
}

html.mobileUI .mMenuList .customSelectOptions > ul > li:first-child { font-weight: bold; }

/* --- misc --------------------------------------------------------------- */

html.mobileUI .logo { display: none; }
html.mobileUI .clear { display: none; }

@media (min-width: 560px) {
	html.mobileUI, html.mobileUI body { font-size: 18px; }
	html.mobileUI #map { font-size: 13px; line-height: 13px; }
}


/* ---------------------------------------------------------------------------
 * One location at a time -- see MobileUI.showOnly.
 *
 * The desktop slides a wide strip behind an overflow-hidden window. In a
 * static single column that does nothing and every panel stacks, so the Room
 * showed the Forest's buttons too.
 * ------------------------------------------------------------------------ */

html.mobileUI .mHidden { display: none; }

/* Buttons read better centred in a single column. */
html.mobileUI #roomPanel > .button,
html.mobileUI #outsidePanel > .button,
html.mobileUI .mBody .button {
	text-align: center;
}


/* ---------------------------------------------------------------------------
 * Fixes from a full-save playtest
 * ------------------------------------------------------------------------ */

/* Location tabs wrap instead of running off the right edge. With the
   Fabricator and Space unlocked there are five, and nowrap put the last two
   past the viewport where they could not be tapped. */
html.mobileUI #header {
	white-space: normal;
	overflow-x: visible;
	display: flex;
	flex-wrap: wrap;
	gap: 2px 4px;
}

html.mobileUI #header .headerButton {
	padding: 8px 10px;
	min-height: 0;
	line-height: 1.3;
	font-size: 0.95em;
}

/* Stores and weapons are long lists of short rows; one per line is several
   screens of scrolling. Two columns roughly halves it, three once there is
   room. */
html.mobileUI #stores,
html.mobileUI #weapons {
	column-count: 2;
	column-gap: 18px;
	font-size: 0.9em;
}

html.mobileUI #stores .storeRow,
html.mobileUI #weapons .storeRow {
	break-inside: avoid;
	padding: 2px 0;
}

@media (min-width: 520px) {
	html.mobileUI #stores,
	html.mobileUI #weapons { column-count: 3; }
}

/* Worker rows: the name and the up/down controls must both fit. Without this
   the controls sat past the right edge and villagers could not be assigned. */
html.mobileUI #workers .storeRow,
html.mobileUI #village .storeRow {
	flex-wrap: nowrap;
	gap: 8px;
	min-width: 0;
}

html.mobileUI #workers .row_key,
html.mobileUI #village .row_key {
	flex: 1 1 auto;
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

html.mobileUI #workers .row_val,
html.mobileUI #village .row_val {
	flex: 0 0 auto;
	display: flex;
	align-items: center;
	gap: 4px;
	white-space: nowrap;
}

html.mobileUI .upBtn,
html.mobileUI .dnBtn,
html.mobileUI .upManyBtn,
html.mobileUI .dnManyBtn {
	margin-left: 0;
	flex: 0 0 auto;
}

/* Nothing in the column may push the page sideways. */
html.mobileUI #wrapper,
html.mobileUI .location,
html.mobileUI .mBody {
	max-width: 100%;
	overflow-x: hidden;
}

/* ---------------------------------------------------------------------------
 * The stoke button's fire
 *
 * main.css animates opacity on the BUTTON ITSELF (flickerFire dips to 0.1),
 * which fades the label along with everything else -- on a phone that reads
 * as a blank box, and was reported as the label being missing or white on
 * white. The desktop gets away with it because its ::after box-shadow paints
 * a dark halo behind, which a light single-column layout does not have.
 *
 * The flicker is moved onto a ::before overlay behind the content, so the
 * fire still pulses and the label stays fully opaque throughout.
 * ------------------------------------------------------------------------ */

html.mobileUI #stokeButton {
	opacity: 1;
	animation: none;
	isolation: isolate;
	overflow: hidden;
}

html.mobileUI #stokeButton::after {
	display: none;      /* the desktop halo is sized for the desktop button */
}

html.mobileUI #stokeButton::before {
	content: '';
	position: absolute;
	inset: 0;
	background: radial-gradient(circle at 20% 50%, rgba(190, 60, 20, 0.55), rgba(190, 60, 20, 0) 70%);
	animation: flickerFire 5s linear reverse infinite;
	pointer-events: none;
	z-index: -1;
}

html.mobileUI.mDark #stokeButton::before {
	background: radial-gradient(circle at 20% 50%, rgba(255, 110, 40, 0.5), rgba(255, 110, 40, 0) 70%);
}


/* ---------------------------------------------------------------------------
 * Second playtest pass
 * ------------------------------------------------------------------------ */

/* --- Button labels ---
 *
 * `line-height: var(--tap)` on a label that wraps produced 48px line boxes
 * inside a 48px button with overflow:hidden. Normal line-height plus vertical
 * padding is the same target size without the clipping risk, and the colour
 * is restated here so it cannot depend on rule order. */
html.mobileUI .button {
	line-height: 1.35;
	min-height: var(--tap);
	padding: 13px 14px;
	overflow: visible;
	color: var(--ink);
}

/* The cooldown fill has to clip instead, now that the button does not. */
html.mobileUI .button .cooldown {
	border-radius: inherit;
	max-width: 100%;
}

/* Disabled text needs real contrast against a dark panel; #999/#777 on
 * #272823 is close to unreadable. */
html.mobileUI.mDark {
	--muted: #8d9088;
}

/* --- Stores / weapons width ---
 *
 * room.css pins div#stores to width:200px. Nothing here overrode it, so the
 * new columns were packed into a 200px box with the rest of the row empty --
 * the cramped columns in the report. */
html.mobileUI #stores,
html.mobileUI #weapons {
	width: 100%;
	max-width: 100%;
	column-count: 2;
	column-gap: 16px;
	column-fill: balance;
}

html.mobileUI #stores .storeRow,
html.mobileUI #weapons .storeRow {
	display: flex;
	justify-content: space-between;
	gap: 10px;
	break-inside: avoid;
	padding: 2px 0;
}

/* --- Villager rows ---
 *
 * These are .workerRow, NOT .storeRow -- the earlier flex rules targeted the
 * wrong class and never applied, which is why the +/- controls stayed
 * invisible. main.css also positions the four arrows absolutely with fixed
 * offsets, meaningless once the row reflows, so they are returned to flow. */
html.mobileUI .workerRow {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 10px;
	padding: 6px 0;
	min-width: 0;
}

html.mobileUI .workerRow > .row_key {
	flex: 1 1 auto;
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

html.mobileUI .workerRow > .row_val {
	flex: 0 0 auto;
	display: flex;
	align-items: center;
	gap: 6px;
	white-space: nowrap;
}

html.mobileUI .workerRow > .row_val > span {
	min-width: 2.5em;
	text-align: right;
}

html.mobileUI .workerRow .upBtn,
html.mobileUI .workerRow .dnBtn,
html.mobileUI .workerRow .upManyBtn,
html.mobileUI .workerRow .dnManyBtn {
	position: static;
	width: 30px;
	height: 30px;
	line-height: 28px;
	text-align: center;
	border: 1px solid var(--line);
	margin: 0;
	flex: 0 0 auto;
}

/* main.css draws the arrowheads with border tricks sized for 14x12 boxes.
   At 30px square a plain glyph is clearer and actually hittable. */
html.mobileUI .workerRow .upBtn::before { content: '+'; }
html.mobileUI .workerRow .dnBtn::before { content: '\2212'; }
html.mobileUI .workerRow .upManyBtn::before { content: '\00BB'; }
html.mobileUI .workerRow .dnManyBtn::before { content: '\00AB'; }

html.mobileUI .workerRow .upBtn::after,
html.mobileUI .workerRow .dnBtn::after,
html.mobileUI .workerRow .upManyBtn::after,
html.mobileUI .workerRow .dnManyBtn::after {
	display: none;
}

html.mobileUI .workerRow .clear { display: none; }

/* --- Language picker ---
 *
 * 26 options rendered as one long list inside the settings panel, which is
 * most of a phone screen. Collapsed behind its own row and laid out in
 * columns when open. */
html.mobileUI .mMenuList .customSelectOptions > ul {
	max-height: 0;
	overflow: hidden;
	transition: max-height 250ms ease;
}

html.mobileUI .mMenuList .customSelect.open .customSelectOptions > ul {
	max-height: 60vh;
	overflow-y: auto;
	column-count: 2;
	column-gap: 12px;
}

html.mobileUI .mMenuList .customSelectOptions > ul > li {
	break-inside: avoid;
	min-height: 40px;
	line-height: 40px;
	font-size: 0.95em;
}

html.mobileUI .mMenuList .customSelectOptions > ul > li:first-child {
	column-span: all;
	font-weight: bold;
}

/* ---------------------------------------------------------------------------
 * Villager assignment controls
 *
 * Worker rows are .workerRow, NOT .storeRow -- an earlier pass styled the
 * wrong class, so none of it applied. main.css also positions the four
 * arrows `position: absolute` with offsets sized for the desktop row, which
 * puts them off-screen once the row reflows into a single column. Returning
 * them to flow is what actually makes them reachable.
 * ------------------------------------------------------------------------ */

html.mobileUI .workerRow {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 10px;
	padding: 6px 0;
	min-width: 0;
}

html.mobileUI .workerRow > .row_key {
	flex: 1 1 auto;
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

html.mobileUI .workerRow > .row_val {
	flex: 0 0 auto;
	display: flex;
	align-items: center;
	gap: 6px;
	white-space: nowrap;
}

html.mobileUI .workerRow > .row_val > span {
	min-width: 2.5em;
	text-align: right;
}

html.mobileUI .workerRow .upBtn,
html.mobileUI .workerRow .dnBtn,
html.mobileUI .workerRow .upManyBtn,
html.mobileUI .workerRow .dnManyBtn {
	position: static;
	width: 30px;
	height: 30px;
	line-height: 28px;
	text-align: center;
	border: 1px solid var(--line);
	margin: 0;
	flex: 0 0 auto;
}

/* main.css draws the arrowheads with border tricks sized for a 14x12 box;
   at 30px square they vanish, so a plain glyph is used instead. */
html.mobileUI .workerRow .upBtn::before { content: '+'; }
html.mobileUI .workerRow .dnBtn::before { content: '\2212'; }
html.mobileUI .workerRow .upManyBtn::before { content: '\00BB'; }
html.mobileUI .workerRow .dnManyBtn::before { content: '\00AB'; }

html.mobileUI .workerRow .upBtn::after,
html.mobileUI .workerRow .dnBtn::after,
html.mobileUI .workerRow .upManyBtn::after,
html.mobileUI .workerRow .dnManyBtn::after {
	display: none;
}

html.mobileUI .workerRow .clear { display: none; }

/* Stores/weapons: room.css pins div#stores to width:200px, which packed the
   columns into a narrow box with the rest of the row empty. */
html.mobileUI #stores,
html.mobileUI #weapons {
	width: 100%;
	max-width: 100%;
}

/* ---------------------------------------------------------------------------
 * Stores and weapons: grid, not multi-column
 *
 * column-count was the wrong tool here and kept failing for reasons that
 * were hard to see:
 *
 *   - room.css pins div#stores to width:200px. Columns then divide 200px,
 *     not the screen, so the 2nd and 3rd columns render inside a box far
 *     narrower than the section -- content appears to run off to the right.
 *   - Multi-column needs break-inside on every child to avoid splitting a
 *     row, and interacts badly with the flex .storeRow children.
 *   - Column boxes have no intrinsic width, so nothing reports overflow;
 *     the layout fails silently rather than visibly.
 *
 * Grid has none of those problems: auto-fill divides the ACTUAL width,
 * every row is an atomic grid item that cannot be split, and the column
 * count adapts to the viewport without media queries. `columns: auto`
 * first, to unset any earlier column-count regardless of where it came
 * from.
 *
 * The height cap plus scroll is the belt-and-braces answer to the same
 * question: even at one column on a very narrow phone, a full late-game
 * store list can never take over the whole page again.
 * ------------------------------------------------------------------------ */

/* :not(.mClosed) is load-bearing, not decoration.
 *
 * Collapsing works by adding .mClosed, whose rule is `display: none` at
 * class specificity. A `display: grid` keyed on #stores / #weapons is ID
 * specificity and beats it outright -- which silently broke collapsing for
 * exactly these two sections while every other section still worked.
 * Excluding the collapsed state here means the two rules never compete, so
 * no !important is needed. */
html.mobileUI #stores:not(.mClosed),
html.mobileUI #weapons:not(.mClosed) {
	columns: auto;                 /* unset any inherited column-count */
	column-count: auto;
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
	gap: 0 16px;
	width: 100%;
	max-width: 100%;
	box-sizing: border-box;
	max-height: 45vh;
	overflow-y: auto;
	-webkit-overflow-scrolling: touch;
	font-size: 0.9em;
}

/* Each row is one grid cell: name left, value right, never split. */
html.mobileUI #stores .storeRow,
html.mobileUI #weapons .storeRow {
	display: flex;
	justify-content: space-between;
	align-items: baseline;
	gap: 8px;
	padding: 3px 0;
	min-width: 0;
}

html.mobileUI #stores .storeRow .row_key,
html.mobileUI #weapons .storeRow .row_key {
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

html.mobileUI #stores .storeRow .row_val,
html.mobileUI #weapons .storeRow .row_val {
	flex: 0 0 auto;
	white-space: nowrap;
}

/* The game inserts float-clearing divs between rows; in a grid each one
   would occupy a cell and punch holes in the layout. */
html.mobileUI #stores .clear,
html.mobileUI #weapons .clear {
	display: none;
}

/* The rows are NOT direct children of #stores.
 *
 * Room.updateStoresView puts them inside #resources and #special wrappers,
 * so the grid saw two items, not thirty: every resource stacked inside one
 * cell and 'compass' alone in the next -- 23 items in column one, 1 in
 * column two, nothing in column three.
 *
 * display:contents removes the wrappers' own boxes and promotes their
 * children to grid items, without the game needing to know. */
html.mobileUI #stores > div,
html.mobileUI #weapons > div {
	display: contents;
}

/* ---------------------------------------------------------------------------
 * Contain the slider strip
 *
 * THE root cause behind both the invisible button labels and the runaway
 * column counts, found from a size badge in devtools: a build button
 * measured 2350 x 52.3.
 *
 * Engine.updateSlider() sets the slider width INLINE, as
 * (number of panels x panel width) -- 4 panels x 595px = 2380px -- because
 * the desktop shows one panel through an overflow-hidden window and slides
 * the strip left and right. Inline styles can only be beaten by !important,
 * so the earlier `width: auto` on these containers never applied.
 *
 * Everything downstream then inherited that width. A button at
 * `width: 100%` became 2350px wide with its label centred at ~1175px --
 * present in the DOM, correctly coloured, and simply off-screen. That is
 * why every inspection showed the text was there. The same 2350px made
 * `repeat(auto-fill, minmax(8.5rem, 1fr))` resolve to about twelve columns,
 * which is the reported 23-items-in-12-columns.
 *
 * MobileUI.showOnly() already hides all but the active panel, so the strip
 * has no job here: pinning it to the viewport is safe and makes every
 * percentage width downstream mean what it says.
 * ------------------------------------------------------------------------ */

html.mobileUI #outerSlider,
html.mobileUI #locationSlider {
	width: 100% !important;
	left: 0 !important;
	top: auto !important;
}

html.mobileUI .location {
	width: 100%;
	max-width: 100%;
}

/* With the width finally correct, a slightly wider minimum keeps the store
   columns readable rather than shaving them to fit. */
html.mobileUI #stores:not(.mClosed),
html.mobileUI #weapons:not(.mClosed) {
	grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
}

/* ---------------------------------------------------------------------------
 * Villager +/- controls: reset the desktop triangles properly
 *
 * main.css draws each arrow with ::before and ::after using
 * `position: absolute; border: medium solid transparent` -- a CSS triangle
 * sized for a 14x12 box. Setting `content` alone left all of that in place,
 * so each control rendered as a positioned bordered box with a glyph inside
 * it, overlapping its neighbours. The pseudo-elements have to be fully
 * neutralised, not just re-labelled.
 * ------------------------------------------------------------------------ */

html.mobileUI .workerRow .upBtn::before,
html.mobileUI .workerRow .dnBtn::before,
html.mobileUI .workerRow .upManyBtn::before,
html.mobileUI .workerRow .dnManyBtn::before {
	position: static;
	border: none;
	width: auto;
	height: auto;
	margin: 0;
	top: auto;
	bottom: auto;
	left: auto;
	font-size: 1rem;
	line-height: 1;
	color: var(--ink);
}

html.mobileUI .workerRow .upBtn::after,
html.mobileUI .workerRow .dnBtn::after,
html.mobileUI .workerRow .upManyBtn::after,
html.mobileUI .workerRow .dnManyBtn::after {
	display: none;
	content: none;
}

html.mobileUI .workerRow .upBtn.disabled,
html.mobileUI .workerRow .dnBtn.disabled,
html.mobileUI .workerRow .upManyBtn.disabled,
html.mobileUI .workerRow .dnManyBtn.disabled {
	opacity: 0.35;
}

/* ---------------------------------------------------------------------------
 * The cooldown fill was painting behind the button
 *
 * main.css gives .cooldown `z-index: -1`, which works on desktop because the
 * button has no background of its own -- the fill shows through. This layer
 * sets an opaque background-color, and a negative-z child of a non-stacking
 * parent paints BEHIND that background, so the animation vanished.
 *
 * `isolation: isolate` makes the button its own stacking context. Painting
 * order inside one is: background, then negative-z descendants, then
 * content -- which is exactly the desktop intent: fill above the background,
 * label above the fill.
 * ------------------------------------------------------------------------ */

html.mobileUI .button {
	isolation: isolate;
}

html.mobileUI .button .cooldown {
	background-color: rgba(255, 255, 255, 0.18);
}

/* ---------------------------------------------------------------------------
 * Outside panel buttons
 *
 * lang/main.css forces `#outsidePanel .button { width: 115px !important }`.
 * Both that and this layer's rule are !important, so specificity decides,
 * and an id beats two classes -- which is why gather wood and check traps
 * stayed small and left-aligned while every other button went full width.
 * Matching the id here wins it back.
 *
 * They also share a row, as suggested: they are the two things a player taps
 * constantly, and side by side keeps both above the fold.
 * ------------------------------------------------------------------------ */

html.mobileUI #outsidePanel > .button {
	width: 100% !important;
}

html.mobileUI #outsidePanel {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
	gap: 0 8px;
	align-items: start;
}

/* Panels that must span the full row rather than sit in a grid cell. */
html.mobileUI #outsidePanel > .mSection,
html.mobileUI #outsidePanel > .mBody,
html.mobileUI #outsidePanel > #village,
html.mobileUI #outsidePanel > #workers {
	grid-column: 1 / -1;
}

/* ---------------------------------------------------------------------------
 * Language picker label
 *
 * Collapsing the whole <ul> hid the first <li>, which IS the button's label
 * ("language.") -- leaving an empty box in the settings menu. Closed now
 * shows exactly that one row; open reveals the rest.
 * ------------------------------------------------------------------------ */

html.mobileUI .mMenuList .customSelectOptions > ul {
	max-height: var(--tap);
	overflow: hidden;
}

html.mobileUI .mMenuList .customSelect.open .customSelectOptions > ul {
	max-height: 60vh;
	overflow-y: auto;
}

html.mobileUI .mMenuList .customSelectOptions > ul > li:first-child {
	font-weight: bold;
	cursor: pointer;
}

/* ---------------------------------------------------------------------------
 * Let the notification log use spare height
 * ------------------------------------------------------------------------ */

html.mobileUI #notifications {
	height: auto;
	min-height: 30vh;
	max-height: 55vh;
}
