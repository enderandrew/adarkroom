msgstr "skrovet återbildas"

#: script/ship.js:58
#: script/space.js:44
msgid "hull: "
msgstr "skrovс: "

#: script/room.js:296
msgid "hungry mouths crave meat. beasts attack wanderers in the wild. wanderers want to strike back. builder says villagers could help hunt, given the means with a hunting lodge."
msgstr "hungriga munnar längtar efter kött. bestar anfaller vandrare i vildmarken. vandrare vill slå tillbaka. byggmästaren säger att bybor kunde hjälpa till att jaga, med rätt medel med en jaktstuga."

#: script/events/outside.js:492
msgid "hunt the pack down"
msgstr "jaga ner flocken"

#: script/localization.js:28
#: script/outside.js:22
msgid "hunter"
msgstr "jägare"

#: script/room.js:106
#: script/room.js:145
msgid "hut"
msgstr "hydda"

#: script/engine.js:1080
#: script/engine.js:1092
#: script/engine.js:219
