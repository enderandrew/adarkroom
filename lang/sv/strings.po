msgid "automated guardians still stalk the halls, unaware that their masters have long gone."
msgstr "automatiserade väktare smyger fortfarande genom hallarna, omedvetna om att deras herrar för länge sedan försvunnit."

#: script/events/executioner.js:616
#: script/fabricator.js:104
msgid "automated turret"
msgstr "automatiserat torn"

#: script/path.js:297
msgid "available"
msgstr "tillgänglig"

