#: script/room.js:515
msgid " builder says the villagers could make steel, given the tools."
msgstr " amatniece saka, ka ciematnieki varētu izgatavot tēraudu, ja viņiem būtu instrumenti."

#: script/outside.js:1705
#: script/outside.js:1755
msgid ", {0} "
msgstr ", {0} "

#: script/events/road.js:871
#: script/localization.js:7
