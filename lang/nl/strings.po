msgstr "{0} zou kunnen helpen jagen, als er middelen waren"

#: script/events/setpieces.js:3457
msgid "{0} of the three are dark now. what is left is still lit."
msgstr "{0} van de drie zijn nu gedoofd. wat overblijft brandt nog."

