msgstr "Een Luidruchtig Dorp"

#: script/events/executioner.js:179
#: script/events/executioner.js:685
#: script/world.js:176
msgid "A Ravaged Battleship"
msgstr "Een Verwoest Slagschip"

#: script/events/encounters.js:120
msgid "A Ravenous Beast"
msgstr "Een Vraatzuchtig Beest"

