#: script/engine.js:33
msgid "melee weapons deal more damage"
msgstr "wapens voor lijfelijk gevecht doen meer schade"

#: script/outside.js:1514
msgid "memories seems as distant and as impossible to reach as those stars. have you been this way before?"
msgstr "herinneringen lijken even ver en onbereikbaar als die sterren. ben je deze weg al eerder gegaan?"

#: script/events/setpieces.js:7271
msgid "men mill about, weapons at the ready."
msgstr "mannen dwalen rond, wapens paraat."

#: script/events/outside.js:676
msgid "mercy is not always repaid. it is still worth extending."
msgstr "genade wordt niet altijd terugbetaald. het is nog steeds de moeite waard om te betonen."

#: script/space.js:312
msgid "Mesosphere"
msgstr "Mesosfeer"

#: script/events/executioner.js:1198
msgid "metal grinds, and the elevator doors open halfway. beyond is a brightly lit battlefield. remains litter the corridor, undisturbed by scavengers."
msgstr "metaal knarst, en de liftdeuren gaan half open. daarachter ligt een fel verlicht slagveld. overblijfselen liggen verspreid in de gang, ongestoord door aaseters."

#: script/events/executioner.js:2369
msgid "might be something useful here."
msgstr "zou hier iets nuttigs kunnen zijn."

#: script/events/setpieces.js:4982
msgid "might be things worth having still inside."
msgstr "er kunnen nog dingen binnen zijn die de moeite waard zijn."

#: script/room.js:1471
msgid "mild"
msgstr "mild"

#: script/events.js:799
msgid "miss"
msgstr "missen"

#: script/lab.js:331
msgid "modern. ancient. familiar. alien."
msgstr "modern. oeroud. vertrouwd. buitenaards."

#: script/events/setpieces.js:5837
msgid "more keep coming"
msgstr "er blijven er meer komen"

#: script/events/executioner.js:1871
msgid "more medical robots stand frozen, attached by a network of wires."
msgstr "meer medische robots staan bevroren, vastgemaakt aan een netwerk van draden."

#: script/events/outside.js:545
msgid "more of them see the morning than would have."
msgstr "meer van hen halen de ochtend dan zou zijn gebeurd."

#: script/events/executioner.js:988
msgid "more signs of past combat down the hall. guard post is ransacked."
msgstr "meer tekenen van vroegere gevechten verderop in de gang. bewakerspost is geplunderd."

#: script/events/setpieces.js:6396
msgid "more soldiers will be on their way."
msgstr "er zullen meer soldaten onderweg zijn."

#: script/events/setpieces.js:5511
msgid "more squatters are crowding around now."
msgstr "er verzamelen zich nu meer krakers."

#: script/events/executioner.js:1888
msgid "more strange graffiti adorns the walls."
msgstr "meer vreemde graffiti siert de muren."

#: script/room.js:37
msgid "more traps to catch more creatures"
msgstr "meer vallen om meer wezens te vangen"

#: script/room.js:38
msgid "more traps won't help now"
msgstr "meer vallen zullen nu niet helpen"

#: script/room.js:588
msgid "more uber traps would be for naught"
msgstr "meer supervallen zouden voor niets zijn"

#: script/events/setpieces.js:5476
msgid "more voices can be heard ahead."
msgstr "meer stemmen zijn te horen voor je."

#: script/events/road.js:302
msgid "morning arrives eventually. so does most of the damage."
msgstr "de ochtend komt uiteindelijk. net als het meeste van de schade."

#: script/events/setpieces.js:305
msgid "most are dead. a few still have something left in them."
msgstr "de meesten zijn dood. enkelen hebben nog iets in zich over."

#: script/events/road.js:792
msgid "most of it is fused. one bulkhead is not, and behind it is a rack of undamaged stock."
msgstr "het meeste is samengesmolten. één schot niet, en erachter is een rek met onbeschadigde voorraad."

#: script/events/setpieces.js:934
msgid "most of the racks are empty"
msgstr "de meeste rekken zijn leeg"

#: script/events/setpieces.js:5064
msgid "most of the windows at ground level are busted anyway."
msgstr "de meeste ramen op de begane grond zijn toch al kapot."

#: script/events/outside.js:285
msgid "most of them come back. not all of them."
msgstr "de meesten komen terug. niet allemaal."

#: script/events/road.js:1049
msgid "most of what was in it is scattered at the bottom of a hole nobody is going back down."
msgstr "het meeste van wat erin zat ligt verspreid op de bodem van een gat waar niemand meer naar teruggaat."

#: script/events/executioner.js:1669
msgid "motion from the centre of the yard."
msgstr "beweging vanuit het midden van de binnenplaats."

#: script/events/outside.js:142
msgid "mourn"
msgstr "rouwen"

#: script/events/road.js:784
#: script/events/setpieces.js:2194
#: script/events/setpieces.js:2243
#: script/events/setpieces.js:2257
msgid "move away from it"
msgstr "ervandaan bewegen"

#: script/events/road.js:1660
#: script/events/road.js:974
msgid "move on"
msgstr "verdergaan"

#: script/events/road.js:276
#: script/events/road.js:329
#: script/events/road.js:357
msgid "move on at dawn"
msgstr "bij zonsopgang verdergaan"

#: script/events/outside.js:1032
#: script/events/outside.js:931
msgid "move the trench"
msgstr "de loopgraaf verplaatsen"

#: script/events/outside.js:1010
msgid "move the trench anyway"
msgstr "de loopgraaf toch verplaatsen"

#: script/events/executioner.js:1683
msgid "murderous robot"
msgstr "moorddadige robot"

#: script/events/executioner.js:883
msgid "must have been the engine room, once. the massive machines now stand inert, twisted and scorched by explosions."
msgstr "moet ooit de machinekamer zijn geweest. de enorme machines staan nu inert, verwrongen en verschroeid door explosies."

#: script/events/encounters.js:1414
msgid "mutant"
msgstr "mutant"

#: script/events/setpieces.js:3118
msgid "near the top, something ceramic and white that does not scratch."
msgstr "bijna bovenaan, iets keramisch en wits dat niet krast."

#: script/events/setpieces.js:3225
msgid "neither has been maintained in a very long time. both are still working."
msgstr "geen van beide is al heel lang onderhouden. beide werken nog steeds."

#: script/room.js:744
msgid "never go thirsty again"
msgstr "nooit meer dorst hebben"

#: script/outside.js:1596
#: script/outside.js:1613
#: script/outside.js:1630
#: script/outside.js:1647
msgid "neverending"
msgstr "eindeloos"

#: script/outside.js:1086
msgid "night sky"
msgstr "nachthemel"

#: script/outside.js:923
msgid "nightmares"
msgstr "nachtmerries"

#: script/outside.js:940
#: script/outside.js:957
msgid "nightmares continue"
msgstr "nachtmerries gaan door"

#: script/outside.js:1029
#: script/outside.js:974
msgid "nightmares worsen"
msgstr "nachtmerries verergeren"

#: script/engine.js:1015
#: script/engine.js:1041
#: script/engine.js:493
#: script/engine.js:797
msgid "no"
msgstr "nee"

#: script/prison.js:259
msgid "no cells. no doors. this passage was built for one arrival."
msgstr "geen cellen. geen deuren. deze doorgang werd gebouwd voor één aankomst."

#: script/events/setpieces.js:3592
msgid "no corner to put your back in. no wall to face. the curve goes on being the same curve in every direction and after a while you stop being able to say which way you came in."
msgstr "geen hoek om je rug tegen te zetten. geen muur om naar te kijken. de bocht blijft dezelfde bocht in elke richting en na een tijdje kun je niet meer zeggen waarlangs je binnenkwam."

#: script/outside.js:1256
msgid "no escape"
msgstr "geen ontsnapping"

#: script/prison.js:248
msgid "no focal point. you observe everything and nothing."
msgstr "geen brandpunt. je waarneemt alles en niets."

#: script/events/setpieces.js:1592
msgid "no glyph may repeat along any line, or within any bordered block."
msgstr "geen teken mag zich herhalen langs een lijn, of binnen een omrand blok."

#: script/ruins.js:154
msgid "no glyph may repeat in any row, in any column, or inside any bordered block. red glyphs are fixed."
msgstr "geen teken mag zich herhalen in een rij, in een kolom, of binnen een omrand blok. rode tekens liggen vast."

#: script/outside.js:1307
msgid "no memory"
msgstr "geen herinnering"

#: script/events/outside.js:658
msgid "no message with it."
msgstr "geen boodschap erbij."

#: script/room.js:133
msgid "no more room for huts."
msgstr "geen ruimte meer voor hutten."

#: script/events/outside.js:112
msgid "no one made it out in time."
msgstr "niemand kwam er op tijd uit."

#: script/graveyard.js:94
msgid "no one wins wars fought with child soldiers"
msgstr "niemand wint oorlogen die gevoerd worden met kindsoldaten"

#: script/engine.js:1853
msgid "no thanks."
msgstr "nee bedankt."

#: script/room.js:1927
msgid "no wooden huts left to rebuild."
msgstr "geen houten hutten meer over om te herbouwen."

#: script/events/room.js:1192
msgid "nobody agrees on what this world is called"
msgstr "niemand is het eens over hoe deze wereld heet"

#: script/events/road.js:673
msgid "nobody agrees on which way is out"
msgstr "niemand is het eens over welke kant de uitgang is"

#: script/events/setpieces.js:1951
msgid "nobody asks what happened, or where you have been, or what you intend to do next."
msgstr "niemand vraagt wat er gebeurd is, of waar je geweest bent, of wat je van plan bent te doen."

#: script/events/outside.js:410
msgid "nobody asks who gave the order. everybody knows."
msgstr "niemand vraagt wie het bevel gaf. iedereen weet het."

#: script/events/road.js:971
msgid "nobody comes to the vent"
msgstr "niemand komt naar de opening"

#: script/events/road.js:968
msgid "nobody comes. the vent breathes. the track stays exactly as worn as it was."
msgstr "niemand komt. de opening ademt. het pad blijft precies zo versleten als het was."

#: script/events/room.js:1057
msgid "nobody in the village asks what happened"
msgstr "niemand in het dorp vraagt wat er gebeurd is"

#: script/events/room.js:1454
msgid "nobody in the village can pronounce it. nobody in the village knows who it belonged to."
msgstr "niemand in het dorp kan het uitspreken. niemand in het dorp weet van wie het was."

#: script/events/outside.js:1027
msgid "nobody in the village can read it, and nobody who comes through that season can either."
msgstr "niemand in het dorp kan het lezen, en niemand die dat seizoen langskomt kan het ook."

#: script/events/room.js:1448
msgid "nobody in the village put them there. the village is not old enough."
msgstr "niemand in het dorp heeft ze daar neergezet. het dorp is niet oud genoeg."

#: script/events/room.js:122
msgid "nobody in the village watches him go. that takes some arranging."
msgstr "niemand in het dorp kijkt hem na. dat vergt enige regeling."

#: script/events/path.js:231
msgid "nobody in the village worked out how to do this. one of the newer arrivals already knew."
msgstr "niemand in het dorp had uitgevonden hoe dit te doen. een van de nieuwere aankomelingen wist het al."

#: script/events/outside.js:639
msgid "nobody objects. that is the part worth noticing."
msgstr "niemand maakt bezwaar. dat is het deel dat de moeite waard is om op te merken."

#: script/events/path.js:127
msgid "nobody points this out to them."
msgstr "niemand wijst hen hierop."

#: script/easterEggs.js:129
#: script/easterEggs.js:135
msgid "nobody says anything after that for a long time."
msgstr "niemand zegt daarna nog lang iets."

#: script/events/path.js:362
msgid "nobody sees who does this."
msgstr "niemand ziet wie dit doet."

#: script/events/road.js:404
msgid "nobody walks away from this much on purpose."
msgstr "niemand loopt met opzet van zoveel weg."

#: script/events/room.js:1577
msgid "nobody will ever know what he was ordering, or who he was ordering it of."
msgstr "niemand zal ooit weten wat hij beval, of van wie."

#: script/events/room.js:139
#: script/events/room.js:216
msgid "Noises"
msgstr "Geluiden"

#: script/events/executioner.js:1980
msgid "noises can be heard from the corridor outside."
msgstr "geluiden zijn te horen vanuit de gang buiten."

#: script/path.js:142
msgid "none"
msgstr "geen"

#: script/events/setpieces.js:3580
msgid "none of it is an escape attempt. all of it is maintenance."
msgstr "niets ervan is een ontsnappingspoging. alles ervan is onderhoud."

#: script/events/road.js:40
msgid "none of it is worth anything. all of it was carried here by somebody."
msgstr "niets ervan is iets waard. alles ervan is hierheen gedragen door iemand."

#: script/events/executioner.js:922
msgid "none of the ship's engines escaped the destruction."
msgstr "geen van de motoren van het schip ontsnapte aan de vernietiging."

#: script/events/outside.js:694
msgid "none of the three have existed for a very long time. they are told so."
msgstr "geen van de drie heeft al heel lang bestaan. dat wordt hun verteld."

#: script/village.js:221
msgid "none of them surrender. none of them run. the singing stops one voice at a time."
msgstr "geen van hen geeft zich over. geen van hen rent. het zingen stopt stem voor stem."

#: script/room.js:1879
#: script/room.js:1947
msgid "not enough {0}"
msgstr "niet genoeg {0}"

#: script/ship.js:144
#: script/ship.js:159
#: script/ship.js:174
msgid "not enough alien alloy"
msgstr "niet genoeg buitenaardse legering"

#: script/localization.js:61
msgid "not enough cloth"
msgstr "niet genoeg stof"

#: script/localization.js:55
msgid "not enough coal"
msgstr "niet genoeg kolen"

#: script/localization.js:53
msgid "not enough fur"
msgstr "niet genoeg bont"

#: script/localization.js:56
msgid "not enough iron"
msgstr "niet genoeg ijzer"

#: script/localization.js:63
msgid "not enough leather"
msgstr "niet genoeg leer"

#: script/localization.js:64
msgid "not enough meat"
msgstr "niet genoeg vlees"

#: script/localization.js:60
msgid "not enough scales"
msgstr "niet genoeg schubben"

#: script/localization.js:57
msgid "not enough steel"
msgstr "niet genoeg staal"

#: script/localization.js:58
msgid "not enough sulphur"
msgstr "niet genoeg zwavel"

#: script/localization.js:62
msgid "not enough teeth"
msgstr "niet genoeg tanden"

#: script/localization.js:54
msgid "not enough wood"
msgstr "niet genoeg hout"

#: script/room.js:1534
msgid "not enough wood to get the fire going"
msgstr "niet genoeg hout om het vuur aan te krijgen"

#: script/events/outside.js:52
msgid "not far from the village lies a large beast, its fur matted with blood."
msgstr "niet ver van het dorp ligt een groot beest, zijn vacht verklit met bloed."

#: script/events/setpieces.js:3736
msgid "not here. not yet. not until there is nowhere left to go and no reason not to know."
msgstr "niet hier. nog niet. niet totdat er nergens meer te gaan is en geen reden meer om het niet te weten."

#: script/events/path.js:124
msgid "not long, they say. one of them says it twice, in the same tone, a minute apart."
msgstr "niet lang, zeggen ze. een van hen zegt het tweemaal, in dezelfde toon, een minuut ertussen."

#: script/events/setpieces.js:6282
msgid "not much here."
msgstr "niet veel hier."

#: script/ruins.js:56
msgid "not one of them can remember changing their mind, and not one of them finds that strange."
msgstr "geen van hen kan zich herinneren van gedachten veranderd te zijn, en geen van hen vindt dat vreemd."

#: script/events/encounters.js:1795
msgid "not quieter. stopped. your own footfall, your own breathing, the wind that has not let up in three days."
msgstr "niet stiller. gestopt. je eigen voetstappen, je eigen ademhaling, de wind die al drie dagen niet is gaan liggen."

#: script/events/setpieces.js:2722
msgid "not somebody like you. you. the same hands. the same set to the jaw. the scar you have had as long as you can remember, already there on a body that has never been outside that glass."
msgstr "niet iemand zoals jij. jij. dezelfde handen. dezelfde stand van de kaak. het litteken dat je hebt zolang je je kunt herinneren, al daar op een lichaam dat nog nooit buiten dat glas is geweest."

#: script/events/setpieces.js:3429
msgid "not two. six. the placements are exact and designed for three humans to concur. a thing that could not be done alone."
msgstr "geen twee. zes. de plaatsingen zijn precies en ontworpen zodat drie mensen het eens moeten worden. iets wat niet alleen gedaan kon worden."

#: script/events/road.js:904
msgid "note where it is and move on"
msgstr "noteer waar het is en ga verder"

#: script/lab.js:324
msgid "notes on the wall in ancient glyphs, in a small tidy hand."
msgstr "aantekeningen op de muur in oude tekens, in een klein net handschrift."

#: script/events.js:1208
#: script/events/room.js:869
msgid "nothing"
msgstr "niets"

#: script/events/room.js:1421
msgid "nothing answered"
msgstr "niets antwoordde"

#: script/events/room.js:1418
msgid "nothing answers back. nothing was ever going to."
msgstr "niets antwoordt terug. niets was dat ooit van plan."

#: script/events/setpieces.js:5269
msgid "nothing but downcast eyes."
msgstr "niets dan neergeslagen ogen."

#: script/events/path.js:248
msgid "nothing can be made of the ash"
msgstr "er kan niets van de as gemaakt worden"

#: script/space.js:1071
msgid "nothing explains it. the ship goes on climbing and nothing comes after it."
msgstr "niets verklaart het. het schip blijft klimmen en niets komt erna."

#: script/events/global.js:95
msgid "nothing goes missing again. his folk come in from the cold, and they work."
msgstr "er verdwijnt nooit meer iets. zijn volk komt uit de kou binnen, en ze werken."

#: script/events/road.js:730
msgid "nothing grows within thirty paces of it. teeth ache at twenty."
msgstr "niets groeit binnen dertig passen ervan. tanden doen pijn bij twintig."

#: script/events/room.js:1729
msgid "nothing happens. it is the loudest nothing you have stood through in a long time."
msgstr "er gebeurt niets. het is het luidste niets dat je al lang hebt doorstaan."

#: script/events/encounters.js:1797
msgid "nothing happens. nothing is there. nothing comes."
msgstr "er gebeurt niets. er is niets. er komt niets."

#: script/engine.js:527
msgid "nothing has been changed. your current game is untouched."
msgstr "er is niets veranderd. je huidige spel is onaangeroerd."

#: script/events/setpieces.js:1214
msgid "nothing has been in here at all"
msgstr "er is helemaal niets hier binnen geweest"

#: script/events/setpieces.js:1212
msgid "nothing has been in here. not dust, not damp, not anything, for a length of time the mind refuses."
msgstr "er is niets hier binnen geweest. geen stof, geen vocht, niets, gedurende een tijdsduur die de geest weigert."

#: script/prison.js:244
msgid "nothing here gives you a straight line to fix on."
msgstr "niets hier geeft je een rechte lijn om op te focussen."

#: script/events/road.js:380
msgid "nothing here was taken in a hurry. it was all set down and left."
msgstr "niets hier werd haastig meegenomen. het werd allemaal neergezet en achtergelaten."

#: script/events/setpieces.js:3341
msgid "nothing here will be."
msgstr "niets hier zal zijn."

#: script/events/setpieces.js:3710
msgid "nothing in here is designed to stop a person leaving. all of it is designed to stop a person being HEARD."
msgstr "niets hierbinnen is ontworpen om iemand tegen te houden bij het vertrekken. alles is ontworpen om te voorkomen dat iemand GEHOORD wordt."

#: script/events/path.js:55
msgid "nothing is lost. nothing is gained. the flats look exactly the same afterwards."
msgstr "niets gaat verloren. niets wordt gewonnen. de vlaktes zien er daarna precies hetzelfde uit."

#: script/events/executioner.js:2315
msgid "nothing more here."
msgstr "niets meer hier."

#: script/events.js:1273
msgid "nothing to take"
msgstr "niets om mee te nemen"

#: script/events/setpieces.js:2080
msgid "nothing touches you. the air does. the doorway arrives very quickly and the road arrives after it."
msgstr "niets raakt je aan. de lucht wel. de deuropening komt heel snel en de weg komt erna."

#: script/events/outside.js:42
msgid "nothing was found"
msgstr "er is niets gevonden"

#: script/events/road.js:1773
msgid "nothing weather does is perfect."
msgstr "niets wat het weer doet is perfect."

#: script/outside.js:878
msgid "noticing the builder staring is at you as if trying to figure something out."
msgstr "merk je op dat de bouwster naar je staart alsof ze iets probeert uit te zoeken."

#: script/room.js:321
msgid "now the nomads have a place to set up shop, they might stick around a while"
msgstr "nu de nomaden een plek hebben om winkel op te zetten, blijven ze misschien een tijdje"

#: script/prison.js:261
msgid "nullified sound. what prisoner would necessitate should a prison"
msgstr "tenietgedaan geluid. wat een gevangene nodig zou hebben mocht er een gevangenis"

#: script/events/executioner.js:2456
msgid "observe"
msgstr "aanschouwen"

#: script/events/setpieces.js:2205
msgid "obsidian shell"
msgstr "obsidiaanschelp"

#: script/events/setpieces.js:93
msgid "offer another charm"
msgstr "nog een amulet aanbieden"

#: script/events/setpieces.js:93
msgid "offer another charm anyway"
msgstr "toch nog een amulet aanbieden"

