msgstr "outra célula sai da linha. a equipe da fundição não levanta os olhos."

#: script/events/executioner.js:2059
msgid "another checkpoint ahead, fitted with heavy doors."
msgstr "outro posto de controle à frente, equipado com portas pesadas."

#: script/events/executioner.js:1294
msgid "another door at the end of the hall, sealed from this side."
msgstr "outra porta no fim do corredor, selada por este lado."

#: script/events/setpieces.js:2822
msgid "another stone, and another name"
msgstr "outra pedra, e outro nome"

