#: script/localization.js:41
#: script/outside.js:88
msgid "armourer"
msgstr "armero"

#: script/room.js:516
#: script/room.js:542
msgid "armoury"
msgstr "armería"

#: script/room.js:520
msgid "armoury's done, welcoming back the weapons of the past."
msgstr "la armería está lista, dando la bienvenida a las armas del pasado."

#: script/outside.js:1545
msgid "arms"
msgstr "brazos"

#: script/events/setpieces.js:6360
msgid "arms and munitions, relics from the war, are neatly arranged on the store-room floor."
msgstr "unos armas y municiones, las reliquias de la guerra, están bien arreglados en el suelo del depósito."

#: script/events/setpieces.js:6204
msgid "as soon as the door is open a little bit, hundreds of tentacles erupt."
msgstr "tan pronto como la puerta se abre un poco, cientos de tentáculos salen de ella."

#: script/events/executioner.js:614
msgid "as the lights come online, so too do the defence systems."
msgstr "al encenderse las luces, también lo hacen los sistemas de defensa."

#: script/events/setpieces.js:1150
msgid "ascendant"
msgstr "ascendente"

#: script/events/path.js:143
msgid "Ash Fall"
msgstr "Caída de Ceniza"

#: script/outside.js:1163
msgid "ask about her injury"
msgstr "preguntar por su herida"

#: script/events/setpieces.js:1831
#: script/events/setpieces.js:1910
msgid "ask about the lab"
msgstr "preguntar por el laboratorio"

#: script/events/path.js:577
msgid "ask about the two who went"
msgstr "preguntar por los dos que se fueron"

#: script/events/setpieces.js:1932
msgid "ask about the watcher"
msgstr "preguntar por el vigilante"

#: script/events/setpieces.js:1921
msgid "ask for a blessing"
msgstr "pedir una bendición"

#: script/events/room.js:855
msgid "ask for insight"
msgstr "pedir perspicacia"

#: script/events/path.js:109
msgid "ask how long they have been out"
msgstr "preguntar cuánto tiempo llevan fuera"

#: script/events/outside.js:933
msgid "ask if anyone can read it"
msgstr "preguntar si alguien puede leerlo"

#: script/events/outside.js:779
msgid "ask them what year they think it is"
msgstr "preguntarles en qué año creen que están"

#: script/events/outside.js:811
msgid "ask them where home was"
msgstr "preguntarles dónde estaba su hogar"

#: script/events/outside.js:622
msgid "ask them who sent them"
msgstr "preguntarles quién los envió"

#: script/events/road.js:644
msgid "ask what is east"
msgstr "preguntar qué hay al este"

#: script/outside.js:1215
msgid "ask what is on her mind."
msgstr "preguntar qué tiene en mente."

#: script/events/setpieces.js:1925
msgid "ask what they see"
msgstr "preguntar qué ven"

#: script/events/room.js:1196
msgid "ask who the oldest are"
msgstr "preguntar quiénes son los más viejos"

#: script/events/room.js:1175
msgid "ask who wrote the last one"
msgstr "preguntar quién escribió el último"

#: script/events/road.js:950
msgid "asked about the vent, he responds that where it leads is classified and that you no longer have Fleet access."
msgstr "al preguntarle por el conducto, responde que su destino es confidencial y que ya no tienes acceso a la Flota."

#: script/events/road.js:948
msgid "asked anything at all, he answers it the way a man answers a question he has answered several thousand times."
msgstr "preguntado lo que sea, responde como responde un hombre a una pregunta que ha contestado varios miles de veces."

#: script/events/outside.js:800
msgid "asked how long ago they worked it out, one of them says it is not the kind of thing you work out once."
msgstr "al preguntarles hace cuánto lo descubrieron, uno de ellos dice que no es algo que se descubra una sola vez."

#: script/events/road.js:947
msgid "asked how long he has been posted here, he says his relief is due, and does not say when it was due from."
msgstr "al preguntarle cuánto tiempo lleva apostado aquí, dice que su relevo está por llegar, y no dice desde cuándo."

#: script/events/outside.js:799
msgid "asked how they know, one of them looks at the lamp instead of answering."
msgstr "al preguntarles cómo lo saben, uno de ellos mira la lámpara en lugar de responder."

#: script/events/outside.js:798
msgid "asked how they know, one of them says: because we were, and we did not either."
msgstr "al preguntarles cómo lo saben, uno de ellos dice: porque nosotros estuvimos, y tampoco lo supimos."

#: script/events/road.js:949
msgid "asked what he is guarding, he responds that a good soldier follows orders without needing to know."
msgstr "al preguntarle qué custodia, responde que un buen soldado sigue órdenes sin necesidad de saber."

#: script/events/road.js:945
msgid "asked what he is guarding, he says that the wing is secure and the prisoner is held."
msgstr "al preguntarle qué custodia, dice que el ala está asegurada y el prisionero retenido."

#: script/events/path.js:232
msgid "asked where she learned it, she says it is what the ash is for."
msgstr "al preguntarle dónde lo aprendió, dice que para eso sirve la ceniza."

#: script/events/road.js:946
msgid "asked who he reports to, he gives a rank and a designation and waits, briefly, as though expecting to be dismissed."
msgstr "al preguntarle a quién reporta, da un rango y una designación y espera, brevemente, como si esperara que lo despidieran."

#: script/events/road.js:1576
msgid "asked who is meant to give it, she turns her head very slightly further out, and does not answer, and goes back under."
msgstr "al preguntarle quién debe darlo, gira la cabeza un poco más hacia afuera, y no responde, y vuelve a sumergirse."

#: script/events/path.js:68
msgid "asked why she will not name it, she says naming it has never once helped."
msgstr "al preguntarle por qué no lo nombrará, dice que nombrarlo nunca ha ayudado."

#: script/events/room.js:332
msgid "asks for any spare furs to keep him warm at night."
msgstr "pide el pelaje que sobre para mantenerse caliente por la noche."

#: script/room.js:2048
#: script/room.js:2055
msgid "asks what it is for. asks why you are putting a roof over people you have not met."
msgstr "pregunta para qué es. pregunta por qué le das techo a gente que no conoces."

#: script/events/setpieces.js:3650
msgid "assay warden"
msgstr "guardián de ensayo"

#: script/events/executioner.js:836
msgid "assembly arms spark and jitter."
msgstr "los brazos de ensamblaje chispean y se sacuden."

#: script/events/executioner.js:782
msgid "assembly arms spin wildly out of control."
msgstr "los brazos de ensamblaje giran fuera de control."

#: script/outside.js:1135
msgid "at first it just seems to be a still sky. there is nothing to see."
msgstr "al principio solo parece un cielo quieto. no hay nada que ver."

#: script/events/executioner.js:1176
msgid "at the back of the workshop, elevator doors twitch and buzz."
msgstr "al fondo del taller, las puertas del ascensor tiemblan y zumban."

#: script/events/road.js:405
msgid "at the bottom of one there is a folded sheet with three names on it and a fourth crossed out."
msgstr "en el fondo de una hay una hoja doblada con tres nombres y un cuarto tachado."

#: script/events/room.js:1170
msgid "at the bottom someone has written: the barren world. it is the only entry not crossed out."
msgstr "al final alguien ha escrito: el mundo yermo. es la única entrada no tachada."

#: script/events/setpieces.js:2300
msgid "at the bottom the ringing stops, and the silence is worse."
msgstr "en el fondo el zumbido cesa, y el silencio es peor."

#: script/events/setpieces.js:2269
msgid "at the centre something is still standing upright, buried to the shoulder, and it did not go off."
msgstr "en el centro algo sigue de pie, enterrado hasta el hombro, y no detonó."

#: script/events/room.js:1378
msgid "at the end it gives the name of the officer expecting the reply."
msgstr "al final da el nombre del oficial que espera la respuesta."

#: script/events/room.js:1337
msgid "at the end it gives the name of the officer expecting the reply. it is giving its own name."
msgstr "al final da el nombre del oficial que espera la respuesta. está dando su propio nombre."

#: script/events/setpieces.js:2741
msgid "at the far end there are two more banks, set apart, and far shorter."
msgstr "al fondo hay dos bancos más, separados, y mucho más cortos."

#: script/events/setpieces.js:2177
msgid "at the lip the glass has gone frothy, full of bubbles, and things came to rest in the froth."
msgstr "en el borde el vidrio se ha vuelto espumoso, lleno de burbujas, y cosas quedaron atrapadas en la espuma."

#: script/events/setpieces.js:7081
#: script/events/setpieces.js:7276
msgid "attack"
msgstr "atacar"

#: script/events/setpieces.js:1175
msgid "attendant"
msgstr "asistente"

#: script/events/setpieces.js:1398
msgid "attending"
msgstr "asistiendo"

#: script/events/executioner.js:1807
msgid "automated guardians still stalk the halls, unaware that their masters have long gone."
msgstr "guardianes automatizados aún acechan los pasillos, ignorantes de que sus amos se fueron hace mucho."

#: script/events/executioner.js:616
#: script/fabricator.js:104
msgid "automated turret"
msgstr "torreta automatizada"

#: script/path.js:297
msgid "available"
msgstr "disponible"

#: script/room.js:1335
msgid "awake. head throbbing. vision blurry."
msgstr "despierto. la cabeza palpita. visión borrosa."

#: script/events/road.js:1482
msgid "back away from it"
msgstr "alejarse de eso"

#: script/events/setpieces.js:3502
#: script/events/setpieces.js:3510
#: script/events/setpieces.js:3518
#: script/events/setpieces.js:3614
#: script/events/setpieces.js:3627
#: script/events/setpieces.js:3640
msgid "back to the junction"
msgstr "volver al cruce"

#: script/outside.js:155
msgid "bad smelling sulphur"
msgstr "azufre de olor fétido"

#: script/localization.js:43
msgid "bait"
msgstr "cebo"

#: script/localization.js:59
msgid "baited trap"
msgstr "trampa con cebo"

#: script/events/room.js:1717
msgid "bar the door"
msgstr "atrancar la puerta"

#: script/engine.js:32
msgid "barbarian"
msgstr "bárbaro"

#: script/events/executioner.js:152
msgid "barrel glows"
msgstr "el cañón brilla"

#: script/events/setpieces.js:6968
msgid "battered technology from both sides lays dormant on the blasted landscape."
msgstr "tecnología maltratada desde ambos lados permanece inactiva en el paisaje arruinado."

#: script/localization.js:33
msgid "bayonet"
msgstr "bayoneta"

#: script/events/room.js:1045
msgid "beaten to a pulp"
msgstr "molido a golpes"

#: script/path.js:198
msgid "become death, destroyer of worlds."
msgstr "conviértete en la muerte, destructora de mundos."

#: script/room.js:1134
msgid "become the destroyer of worlds. use a nuke to kill the most deadly of foes. builder can channel wanderer technology to craft a handheld nuke."
msgstr "conviértete en el destructor de mundos. usa una bomba nuclear para matar al más letal de los enemigos. la constructora puede canalizar tecnología errante para fabricar una bomba nuclear portátil."

#: script/events/setpieces.js:3826
msgid "bedrolls, torn and blackened, lay beneath a thin layer of dust."
msgstr "los sacos de dormir, desgarrados y ennegrecidos, yacían bajo una fina capa de polvo."

#: script/swamp.js:85
msgid "before, there was an end to each one, and a world at the end of it. after, there was only the next."
msgstr "antes, había un final para cada uno, y un mundo al final de este. después, solo había el siguiente."

#: script/events/executioner.js:482
msgid "behind the barricade, a few weapons lay abandoned."
msgstr "detrás de la barricada, hay algunas armas abandonadas."

#: script/events/setpieces.js:6148
msgid "behind the door, a deformed figure awakes and attacks."
msgstr "detrás de la puerta, una figura deforme se lavanta y ataca."

#: script/events/setpieces.js:1681
msgid "behind the rack the wall carries a second grid, larger than the first, and lit a different colour."
msgstr "detrás del estante la pared lleva una segunda rejilla, más grande que la primera, e iluminada de otro color."

#: script/events/setpieces.js:2081
msgid "behind you the doors close, and go on closing, past the point where a door would stop."
msgstr "detrás de ti las puertas se cierran, y siguen cerrándose, más allá del punto donde una puerta debería detenerse."

#: script/events/setpieces.js:7365
msgid "bellowing"
msgstr "bramando"

#: script/events/setpieces.js:4864
msgid "beneath the wanderer's rags, clutched in one of its many hands, a glint of steel."
msgstr "debajo de los harapos del vagabundo, argarrado por una de sus muchas manos, un centelleo de acero."

#: script/engine.js:63
msgid "better avoid conflict in the wild"
msgstr "mejor evita el conflicto en lo salvaje"

#: script/events/executioner.js:1979
msgid "better to move without drawing attention."
msgstr "mejor moverse sin llamar la atención."

#: script/events/executioner.js:666
msgid "beyond the bulkhead is a small antechamber, seemingly untouched by scavengers."
msgstr "más allá del mamparo hay una pequeña antecámara, aparentemente intacta por los carroñeros."

#: script/events/encounters.js:1282
msgid "bigfoot"
msgstr "pie grande"

#: script/events/encounters.js:1272
msgid "Bigfoot"
msgstr "Pie Grande"

#: script/events/setpieces.js:6247
msgid "bird must have liked shiney things."
msgstr "al pájaro deben haberle gustado las cosas brillantes."

#: script/outside.js:107
msgid "bits of meat"
msgstr "pedazos de carne"

#: script/events/executioner.js:885
msgid "bits of them can be scavenged."
msgstr "partes de ellos se pueden rescatar."

#: script/room.js:1081
msgid "black powder and bullets, like the old days."
msgstr "pólvora negra y balas, como en los viejos tiempos."

#: script/events/road.js:1329
msgid "black rain, and it does not rain out here"
msgstr "lluvia negra, y aquí afuera no llueve"

#: script/world.js:101
msgid "blast"
msgstr "estallar"

