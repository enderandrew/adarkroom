#: script/events/executioner.js:1019
#: script/events/executioner.js:1044
#: script/events/executioner.js:1059
#: script/events/executioner.js:1073
#: script/events/executioner.js:1089
#: script/events/executioner.js:1112
#: script/events/executioner.js:1168
#: script/events/executioner.js:1184
#: script/events/executioner.js:1207
#: script/events/executioner.js:1228
#: script/events/executioner.js:1272
#: script/events/executioner.js:1286
#: script/events/executioner.js:1303
#: script/events/executioner.js:1318
#: script/events/executioner.js:1333
#: script/events/executioner.js:1349
#: script/events/executioner.js:1377
#: script/events/executioner.js:1401
#: script/events/executioner.js:1415
#: script/events/executioner.js:1432
#: script/events/executioner.js:1446
#: script/events/executioner.js:1464
#: script/events/executioner.js:1487
