msgstr "un registro llevado a diario durante once años"

#: script/events/setpieces.js:40
msgid "a lone frog sits in the muck, silently."
msgstr "un sapo solitario se encuentra sentado en el estiércol, silencioso."

#: script/outside.js:812
msgid "A Lonely Hut"
msgstr "Una Cabaña Solitaria"

#: script/events/setpieces.js:615
msgid "a long room, entirely empty, with a single chair at the far end facing away."
msgstr "una sala larga, completamente vacía, con una sola silla al fondo dando la espalda."

#: script/events/encounters.js:1047
