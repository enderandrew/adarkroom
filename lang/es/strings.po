msgstr "bocas hambrientas ansían carne. las bestias atacan a los errantes en la naturaleza. los errantes quieren contraatacar. la constructora dice que los aldeanos podrían ayudar a cazar, con los medios de un refugio de caza."

#: script/events/outside.js:485
msgid "hunt the pack down"
msgstr "cazar a la manada"

#: script/localization.js:28
#: script/outside.js:22
msgid "hunter"
msgstr "cazador"

#: script/room.js:126
#: script/room.js:87
