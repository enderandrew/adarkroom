#: script/events/encounters.js:1635
msgid "a pack animal, alive, standing in the open with nobody anywhere near it."
msgstr "un animal de carga, vivo, parado en el campo abierto sin nadie cerca."

#: script/events/encounters.js:636
msgid "A Pack of Beasts"
msgstr "Una Manada de Bestias"

#: script/events/setpieces.js:5667
