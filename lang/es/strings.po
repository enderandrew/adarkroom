msgstr "una proyección cambiante de esta sala y de este planeta."

#: script/events/setpieces.js:35
msgid "A Murky Swamp"
msgstr "Un Pantano Turbio"

#: script/events/encounters.js:1406
msgid "A Mutant"
msgstr "Un Mutante"

#: script/events/executioner.js:2278
