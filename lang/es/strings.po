msgstr "una plataforma móvil de defensa avanza ruidosamente tras la esquina."

#: script/outside.js:802
msgid "A Modest Encampment"
msgstr "Un Campamento Modesto"

#: script/outside.js:816
msgid "A Modest Village"
msgstr "Una Aldea Modesta"

