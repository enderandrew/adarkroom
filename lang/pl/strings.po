msgstr "kilkaset kroków dalej klęczący kończą się, wszyscy naraz, w równej linii."

#: script/events/setpieces.js:6585
msgid "a few items are scattered on the ground."
msgstr "kilka przedmiotów jest rozsianych po podłożu."

#: script/events/road.js:762
msgid "a few minutes at this distance is survivable. more is not."
msgstr "kilka minut w tej odległości da się przeżyć. więcej już nie."

#: script/events/setpieces.js:932
msgid "a few of the racks are not empty."
msgstr "kilka z regałów nie jest pustych."

#: script/events/executioner.js:1357
msgid "a few useful items can be scavenged."
msgstr "można tu znaleźć kilka użytecznych przedmiotów."

#: script/events/setpieces.js:4652
msgid "a fight, maybe."
msgstr "może walka."

#: script/events/outside.js:116
msgid "a fire has started"
msgstr "wybuchł pożar"

#: script/events/outside.js:111
msgid "a fire rampages through one of the huts, destroying it."
msgstr "ogień trawi jedną z chat. zostają zgliszcza."

#: script/room.js:1496
msgid "A Firelit Room"
msgstr "Oświetlony pokój"

#: script/path.js:177
msgid "a fleet mark. the emblem of a society that is not there any more."
msgstr "znak floty. godło społeczności, której już nie ma."

#: script/lab.js:325
msgid "a floor drain, and a faint slope in the concrete leading to it."
msgstr "odpływ w podłodze i lekkie nachylenie betonu w jego kierunku."

#: script/events/setpieces.js:6963
msgid "A Forgotten Battlefield"
msgstr "Zapomniane Pole Bitwy"

