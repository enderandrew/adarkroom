msgstr "ogromny jaszczur lezie przed siebie"

#: script/events/encounters.js:478
msgid "A Glass Wolf"
msgstr "Szklany Wilk"

#: script/events/setpieces.js:2123
#: script/world.js:178
msgid "A Glassed Crater"
msgstr "Zeszklony Krater"

#: script/events/setpieces.js:1594
