msgstr "zmieniająca się projekcja tego pomieszczenia i tej planety."

#: script/events/setpieces.js:35
#: script/world.js:175
msgid "A Murky Swamp"
msgstr "Mroczne Bagno"

#: script/events/encounters.js:1406
msgid "A Mutant"
msgstr "Mutant"

#: script/events/executioner.js:2278
msgid "a mutated beast leaps from its cell."
msgstr "zmutowana bestia wyskakuje ze swojej celi."

#: script/events/room.js:543
#: script/events/room.js:627
msgid "a mysterious wanderer arrives"
msgstr "tajemniczy wędrowiec przybywa"

#: script/ruins.js:59
