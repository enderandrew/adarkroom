msgstr "konstrukt laboratoryjny"

#: script/events/setpieces.js:2602
msgid "lab custodian"
msgstr "dozorca laboratorium"

#: script/events/setpieces.js:2563
msgid "lab warden"
msgstr "strażnik laboratorium"

#: script/engine.js:53
msgid "land blows more often"
msgstr "ciosy trafiają częściej"

#: script/events/executioner.js:1455
msgid "large barricades bisect the corridor, scorched by weapons fire."
msgstr "wielkie barykady przecinają korytarz, osmalone ogniem broni."

#: script/events/outside.js:14
msgid "large prints lead away, into the forest."
msgstr "wielkie znaczniki wskazują ci drogę do lasu."

#: script/room.js:900
msgid "larger conquests need to be carried back. builder can leverage wanderer engineering to craft a convoy."
msgstr "większe zdobycze trzeba przynieść z powrotem. budowniczyni potrafi wykorzystać inżynierię wędrowców, by zbudować konwój."

#: script/localization.js:47
msgid "laser rifle"
msgstr "karabin laserowy"

#: script/ship.js:213
msgid "lasers maxed"
msgstr "lasery na maksimum"

#: script/ship.js:70
msgid "lasers: "
msgstr "lasery: "

#: script/events/setpieces.js:3660
msgid "lattice warden"
msgstr "strażnik kraty"

#: script/events/room.js:724
msgid "learn scouting"
msgstr "naucz się zwiadu"

#: script/engine.js:64
msgid "learned how not to be seen"
msgstr "nauczyłeś się być niedostrzegalnym"

#: script/engine.js:39
msgid "learned how to ignore the hunger"
msgstr "nauczyłeś się ignorować głód"

#: script/engine.js:74
msgid "learned that conserving resources and moving fast can increase distance traveled"
msgstr "nauczono się, że oszczędzanie zasobów i szybkie poruszanie się może zwiększyć pokonywany dystans"

#: script/engine.js:49
msgid "learned to be where they're not"
msgstr "nauczył się być tam, gdzie ich nie ma"

#: script/engine.js:23
msgid "learned to fight quite effectively without weapons"
msgstr "nauczyłeś się dość dobrze walczyć bez broni"

#: script/engine.js:59
msgid "learned to look ahead"
msgstr "nauczyłeś się być bardziej spostrzegawczym"

#: script/engine.js:44
msgid "learned to love the dry air"
msgstr "nauczyłeś się kochać suche powietrze"

#: script/engine.js:69
msgid "learned to make the most of food"
msgstr "nauczyłeś się przyrządzać większość potraw"

#: script/engine.js:54
msgid "learned to predict their movement"
msgstr "nauczyłeś się przewidywać ich posunięcia"

#: script/engine.js:29
msgid "learned to strike faster without weapons"
msgstr "nauczyłeś się uderzać szybciej gołymi pięściami"

#: script/engine.js:34
msgid "learned to swing weapons with force"
msgstr "nauczyłeś się machać bronią z większą siłą"

#: script/engine.js:18
msgid "learned to throw punches with purpose"
msgstr "nauczyłeś się uderzać z większą precyzją"

