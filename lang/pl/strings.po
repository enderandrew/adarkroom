msgstr "mobilna platforma obronna nadjeżdża zza rogu."

#: script/outside.js:802
msgid "A Modest Encampment"
msgstr "Skromny Obóz"

#: script/outside.js:816
msgid "A Modest Village"
msgstr "Skromna wieś"

#: script/events/setpieces.js:1974
