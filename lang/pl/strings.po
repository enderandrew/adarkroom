msgstr "skrzyżowanie, a od niego trzy drogi, z których każda kończy się kształtem widocznym już stąd."

#: script/events/setpieces.js:3994
msgid "a large beast charges out of the dark"
msgstr "ogromna bestia szarżuje z ciemności"

#: script/events/setpieces.js:5742
