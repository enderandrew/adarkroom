#: script/events/room.js:724
msgid "learn scouting"
msgstr "вивчити розвідку"

#: script/engine.js:64
msgid "learned how not to be seen"
msgstr "навчає бути непомітним"

#: script/engine.js:39
msgid "learned how to ignore the hunger"
msgstr "дозволяє ігнорувати голод"

#: script/engine.js:74
msgid "learned that conserving resources and moving fast can increase distance traveled"
msgstr "дізналися, що заощадження ресурсів і швидке пересування можуть збільшити пройдену відстань"

#: script/engine.js:49
msgid "learned to be where they're not"
msgstr "навчаю ухилятися від ударів"

#: script/engine.js:23
msgid "learned to fight quite effectively without weapons"
msgstr "навчає ефективно битися без зброї"

#: script/engine.js:59
msgid "learned to look ahead"
msgstr "навчає бачити далі"

#: script/engine.js:44
msgid "learned to love the dry air"
msgstr "навчає, як отримувати воду з повітря"

#: script/engine.js:69
msgid "learned to make the most of food"
msgstr "навчає, як приготувати більше їжі"

#: script/engine.js:54
msgid "learned to predict their movement"
msgstr "навчає передбачати рухи"

#: script/engine.js:29
