#: script/lab.js:346
msgid "how deep do these tunnels go? why is it so cold?"
msgstr "kiom profunde iras ĉi tiuj tuneloj? kial estas tiel malvarme?"

#: script/lab.js:332
msgid "how did the watcher temple have a key to thos place?"
msgstr "kial la templo de la observanto havis ŝlosilon al ĉi tiu loko?"

