msgstr "užstodamas kelią priešiškai stovi gležnas vyras."

#: script/events/setpieces.js:438
msgid "a gallery of alcoves, each holding a shape that is almost a person and is not."
msgstr "nišų galerija, kiekvienoje – figūra, beveik panaši į žmogų, bet ne."

#: script/events/encounters.js:194
msgid "A Gaunt Human"
msgstr "Sulysęs Žmogus"

