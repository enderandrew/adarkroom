#: script/events/encounters.js:49
msgid "A Dust Wretch"
msgstr "Dulkių Vargeta"

#: script/path.js:33
#: script/path.js:339
msgid "A Dusty Path"
msgstr "Dulkėtas Kelias"

#: script/events/executioner.js:440
msgid "a dusty researcher clumsily hides in the shadows."
msgstr "dulkėtas tyrėjas nerangiai slepiasi šešėliuose."

#: script/lab.js:337
msgid "a faint scent of smoke, and under it something organic."
msgstr "silpnas dūmų kvapas, o po juo – kažkas organiško."

#: script/events/encounters.js:930
msgid "A Feral Terror"
