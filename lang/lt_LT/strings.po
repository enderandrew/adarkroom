msgstr "tvarkinga karinė kolona. vienoda ekipuotė, laikoma rikiuotė, kažkas duodantis įsakymus."

#: script/events/encounters.js:310
msgid "A Radiated Goat"
msgstr "Apnuodyta Radiacija Ožka"

#: script/events/encounters.js:349
msgid "a radiated goat charges with its mutated antlers"
msgstr "apnuodyta radiacija ožka puola mutavusiais ragais"

#: script/room.js:1659
