msgstr "A Dark Room parašė Michael Townsend „Doublespeak Games\" 2013 m. Tai atviro kodo projektas."

#: script/room.js:1363
#: script/room.js:1496
msgid "A Darker Room"
msgstr "Tamsesnis Kambarys"

#: script/events/setpieces.js:4184
msgid "A Deserted Town"
msgstr "Apleistas Miestelis"

#: script/path.js:186
msgid "a desperate weapon for desperate men."
msgstr "beviltiškas ginklas beviltiškiems žmonėms."

#: script/events/setpieces.js:7496
msgid "A Destroyed Village"
