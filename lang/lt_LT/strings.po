#: script/events/setpieces.js:5667
msgid "a pack of lizards rounds the corner."
msgstr "iš už kampo išlenda driežų gauja."

#: script/village.js:162
msgid "a pack of snarling beasts pours out of the trees."
msgstr "iš medžių iššoka gauja urzgiančių žvėrių."

#: script/outside.js:1409
#: script/outside.js:1426
#: script/outside.js:1443
msgid "a pang"
msgstr "aštrus skausmo dūris"

#: script/events/setpieces.js:4724
msgid "a panicked scavenger bursts through the door, screaming."
msgstr "panikuodamas, rėkdamas ieškotojas įsiveržia pro duris."

#: script/events/path.js:388
msgid "a party comes up the path, carrying one of their own"
