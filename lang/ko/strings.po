msgstr "그것들 밑에 묻힌 채, 감싸이고 밀봉되어, 물이 있다. 상당한 양이다."

#: script/events/road.js:248
msgid "burn a torch through the night"
msgstr "밤새 횃불을 태운다"

#: script/events/road.js:1631
msgid "burn it"
msgstr "그것을 태운다"

#: script/events/room.js:1494
msgid "burn it unopened"
msgstr "열지 않고 태운다"

#: script/events/room.js:1529
msgid "burn the cards"
msgstr "카드를 태운다"

#: script/events/outside.js:354
msgid "burn the infected huts"
msgstr "감염된 오두막을 태운다"

#: script/events/path.js:677
msgid "burn whatever burns"
msgstr "탈 수 있는 것은 모두 태운다"

#: script/room.js:1491
msgid "burning"
msgstr "타오른다"

