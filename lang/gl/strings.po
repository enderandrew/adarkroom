#: script/engine.js:44
msgid "learned to love the dry air"
msgstr "aprendeuse a amar o aire seco"

#: script/engine.js:69
msgid "learned to make the most of food"
msgstr "aprendeuse a aproveitar ao máximo a comida"

#: script/engine.js:54
