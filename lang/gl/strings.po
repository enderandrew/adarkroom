msgid "another beast, drawn by the noise, leaps out of a copse of trees."
msgstr "outra besta, atraída polo ruído, salta desde un boscallo."

#: script/easterEggs.js:34
msgid "another cairn, and this one has been counted."
msgstr "outro monumento de pedras, e este xa se contou."

#: script/room.js:225
