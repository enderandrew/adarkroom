msgstr "unha sala onde unha vez se condenou a galaxia e despois se encarcerou a un inocente."

#: script/prison.js:234
msgid "a room with 11 chairs and a 12th empty spot."
msgstr "unha sala con 11 cadeiras e un 12º espazo baleiro."

#: script/lab.js:358
msgid "a room with no fittings at all, and a drain in the middle of the floor."
msgstr "unha sala sen ningún mobiliario, e un desaugadoiro no medio do chan."

#: script/prison.js:251
msgid "a round wing with no point. there is no point. nothing to gleam."
msgstr "unha ala redonda sen punta. non hai punta. nada que brille."

#: script/events/setpieces.js:4976
msgid "A Ruined City"
msgstr "Unha Cidade en Ruínas"

#: script/events/outside.js:6
msgid "A Ruined Trap"
msgstr "Unha Trampa Desfeita"

#: script/events/encounters.js:81
msgid "A Rust Beetle"
msgstr "Un Escaravello de Ferruxe"

