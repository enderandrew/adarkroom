msgstr "máis trampas para cazar máis criaturas"

#: script/room.js:38
msgid "more traps won't help now"
msgstr "máis trampas non sirven de nada agora"

#: script/room.js:588
msgid "more uber traps would be for naught"
msgstr "máis supertrampas serían inútiles"

#: script/events/setpieces.js:5476
msgid "more voices can be heard ahead."
msgstr "óense máis voces adiante."

#: script/events/road.js:302
msgid "morning arrives eventually. so does most of the damage."
msgstr "a mañá chega ao final. e tamén a maior parte do dano."

#: script/events/setpieces.js:305
msgid "most are dead. a few still have something left in them."
msgstr "a maioría están mortos. uns poucos aínda teñen algo dentro."

#: script/events/road.js:792
msgid "most of it is fused. one bulkhead is not, and behind it is a rack of undamaged stock."
msgstr "a maior parte está fundida. un mamparo non o está, e detrás del hai un estante con existencias intactas."

#: script/events/setpieces.js:934
msgid "most of the racks are empty"
msgstr "a maioría dos estantes están baleiros"

#: script/events/setpieces.js:5064
msgid "most of the windows at ground level are busted anyway."
msgstr "de todos os xeitos, a maior parte das ventás a altura do chan están rotas."

#: script/events/outside.js:285
msgid "most of them come back. not all of them."
msgstr "a maioría deles volven. non todos."

#: script/events/road.js:1049
msgid "most of what was in it is scattered at the bottom of a hole nobody is going back down."
msgstr "a maior parte do que había dentro está espallado no fondo dun burato ao que ninguén vai volver baixar."

#: script/events/executioner.js:1669
msgid "motion from the centre of the yard."
msgstr "movemento desde o centro do patio."

#: script/events/outside.js:142
msgid "mourn"
msgstr "loito"

#: script/events/road.js:784
#: script/events/setpieces.js:2194
#: script/events/setpieces.js:2243
#: script/events/setpieces.js:2257
msgid "move away from it"
msgstr "afastarse del"

#: script/events/road.js:1660
#: script/events/road.js:974
msgid "move on"
msgstr "seguir adiante"

#: script/events/road.js:276
#: script/events/road.js:329
#: script/events/road.js:357
msgid "move on at dawn"
msgstr "seguir adiante ao amencer"

#: script/events/outside.js:1032
#: script/events/outside.js:931
msgid "move the trench"
msgstr "mover a trincheira"

#: script/events/outside.js:1010
msgid "move the trench anyway"
msgstr "mover a trincheira de todos os xeitos"

#: script/events/executioner.js:1683
msgid "murderous robot"
msgstr "robot asasino"

#: script/events/executioner.js:883
msgid "must have been the engine room, once. the massive machines now stand inert, twisted and scorched by explosions."
msgstr "debeu ser a sala de máquinas, algunha vez. as máquinas masivas permanecen inertes agora, retorcidas e chamuscadas por explosións."

#: script/events/encounters.js:1414
msgid "mutant"
msgstr "mutante"

#: script/events/setpieces.js:3118
msgid "near the top, something ceramic and white that does not scratch."
msgstr "preto do cume, algo cerámico e branco que non se raia."

#: script/events/setpieces.js:3225
msgid "neither has been maintained in a very long time. both are still working."
msgstr "ningún dos dous recibiu mantemento en moitísimo tempo. os dous aínda funcionan."

#: script/room.js:744
msgid "never go thirsty again"
msgstr "non ter sede nunca máis"

#: script/outside.js:1596
#: script/outside.js:1613
#: script/outside.js:1630
#: script/outside.js:1647
msgid "neverending"
msgstr "interminable"

#: script/outside.js:1086
msgid "night sky"
msgstr "ceo nocturno"

#: script/outside.js:923
msgid "nightmares"
msgstr "pesadelos"

#: script/outside.js:940
#: script/outside.js:957
msgid "nightmares continue"
msgstr "os pesadelos continúan"

#: script/outside.js:1029
#: script/outside.js:974
msgid "nightmares worsen"
msgstr "os pesadelos empeoran"

#: script/engine.js:1007
#: script/engine.js:1033
#: script/engine.js:485
#: script/engine.js:789
msgid "no"
msgstr "non"

#: script/prison.js:259
msgid "no cells. no doors. this passage was built for one arrival."
msgstr "sen celas. sen portas. esta pasaxe construíuse para unha soa chegada."

#: script/events/setpieces.js:3592
msgid "no corner to put your back in. no wall to face. the curve goes on being the same curve in every direction and after a while you stop being able to say which way you came in."
msgstr "ningunha esquina onde apoiar as costas. ningún muro ao que mirar. a curva segue sendo a mesma curva en todas as direccións e ao cabo dun anaco xa non podes dicir por onde entraches."

#: script/outside.js:1256
msgid "no escape"
msgstr "sen escapatoria"

#: script/prison.js:248
msgid "no focal point. you observe everything and nothing."
msgstr "sen punto focal. observas todo e nada."

#: script/events/setpieces.js:1592
msgid "no glyph may repeat along any line, or within any bordered block."
msgstr "ningún glifo pode repetirse ao longo dunha liña, nin dentro dun bloque delimitado."

#: script/ruins.js:154
msgid "no glyph may repeat in any row, in any column, or inside any bordered block. red glyphs are fixed."
msgstr "ningún glifo pode repetirse en ningunha fila, en ninguna columna, nin dentro dun bloque delimitado. os glifos vermellos son fixos."

#: script/outside.js:1307
msgid "no memory"
msgstr "sen memoria"

#: script/events/outside.js:658
msgid "no message with it."
msgstr "sen mensaxe."

#: script/room.js:133
msgid "no more room for huts."
msgstr "xa non queda sitio para máis cabanas."

#: script/events/outside.js:112
msgid "no one made it out in time."
msgstr "ninguén saíu a tempo."

#: script/graveyard.js:94
msgid "no one wins wars fought with child soldiers"
msgstr "ninguén gaña guerras loitadas con soldados nenos"

#: script/engine.js:1773
msgid "no thanks."
msgstr "non, grazas."

#: script/room.js:1927
msgid "no wooden huts left to rebuild."
msgstr "xa non quedan cabanas de madeira que reconstruír."

#: script/events/room.js:1192
msgid "nobody agrees on what this world is called"
msgstr "ninguén se pon de acordo sobre como se chama este mundo"

#: script/events/road.js:673
msgid "nobody agrees on which way is out"
msgstr "ninguén se pon de acordo sobre por onde é a saída"

#: script/events/setpieces.js:1951
msgid "nobody asks what happened, or where you have been, or what you intend to do next."
msgstr "ninguén pregunta que pasou, nin onde estiveches, nin que pensas facer a continuación."

#: script/events/outside.js:410
msgid "nobody asks who gave the order. everybody knows."
msgstr "ninguén pregunta quen deu a orde. todos o saben."

#: script/events/road.js:971
msgid "nobody comes to the vent"
msgstr "ninguén se achega á ventilación"

#: script/events/road.js:968
msgid "nobody comes. the vent breathes. the track stays exactly as worn as it was."
msgstr "ninguén ven. a ventilación respira. o rastro segue exactamente tan gastado coma antes."

#: script/events/room.js:1057
msgid "nobody in the village asks what happened"
msgstr "ninguén na vila pregunta que pasou"

#: script/events/room.js:1454
msgid "nobody in the village can pronounce it. nobody in the village knows who it belonged to."
msgstr "ninguén na vila o pode pronunciar. ninguén na vila sabe a quen pertenceu."

#: script/events/outside.js:1027
msgid "nobody in the village can read it, and nobody who comes through that season can either."
msgstr "ninguén na vila o pode ler, e tampouco ninguén dos que pasan por alí esa tempada."

#: script/events/room.js:1448
msgid "nobody in the village put them there. the village is not old enough."
msgstr "ninguén na vila os puxo alí. a vila non é tan vella."

#: script/events/room.js:122
msgid "nobody in the village watches him go. that takes some arranging."
msgstr "ninguén na vila o ve marchar. iso require certa organización."

#: script/events/path.js:231
msgid "nobody in the village worked out how to do this. one of the newer arrivals already knew."
msgstr "ninguén na vila descubriu como facer isto. un dos recén chegados xa o sabía."

#: script/events/outside.js:639
msgid "nobody objects. that is the part worth noticing."
msgstr "ninguén se opón. esa é a parte que paga a pena notar."

#: script/events/path.js:127
msgid "nobody points this out to them."
msgstr "ninguén llelo fai notar."

#: script/easterEggs.js:129
#: script/easterEggs.js:135
msgid "nobody says anything after that for a long time."
msgstr "ninguén di nada despois diso durante moito tempo."

#: script/events/path.js:362
msgid "nobody sees who does this."
msgstr "ninguén ve quen fai isto."

#: script/events/road.js:404
msgid "nobody walks away from this much on purpose."
msgstr "ninguén se afasta de tanto a propósito."

#: script/events/room.js:1577
msgid "nobody will ever know what he was ordering, or who he was ordering it of."
msgstr "ninguén saberá nunca que estaba a ordenar, nin a quen llo estaba a ordenar."

#: script/events/room.js:139
#: script/events/room.js:216
msgid "Noises"
msgstr "Ruídos"

#: script/events/executioner.js:1980
msgid "noises can be heard from the corridor outside."
msgstr "óense ruídos desde o corredor exterior."

#: script/path.js:142
msgid "none"
msgstr "ningún"

#: script/events/setpieces.js:3580
msgid "none of it is an escape attempt. all of it is maintenance."
msgstr "nada diso é un intento de fuga. todo é mantemento."

#: script/events/road.js:40
msgid "none of it is worth anything. all of it was carried here by somebody."
msgstr "nada diso vale nada. todo o trouxo alguén ata aquí."

#: script/events/executioner.js:922
msgid "none of the ship's engines escaped the destruction."
msgstr "ningún dos motores da nave escapou da destrución."

#: script/events/outside.js:694
msgid "none of the three have existed for a very long time. they are told so."
msgstr "ningún dos tres existiu durante moitísimo tempo. dínselo así."

#: script/village.js:221
msgid "none of them surrender. none of them run. the singing stops one voice at a time."
msgstr "ningún deles se rende. ningún deles foxe. o canto detense unha voz de cada vez."

#: script/room.js:1879
#: script/room.js:1947
msgid "not enough {0}"
msgstr "non hai {0} dabondo"

#: script/ship.js:144
#: script/ship.js:159
#: script/ship.js:174
msgid "not enough alien alloy"
msgstr "non hai aliaxe alieníxena abonda"

#: script/localization.js:61
msgid "not enough cloth"
msgstr "non hai tea abonda"

#: script/localization.js:55
msgid "not enough coal"
msgstr "non hai carbón abondo"

#: script/localization.js:53
msgid "not enough fur"
msgstr "non hai pel abonda"

#: script/localization.js:56
msgid "not enough iron"
msgstr "non hai ferro abondo"

#: script/localization.js:63
msgid "not enough leather"
msgstr "non hai coiro abondo"

#: script/localization.js:64
msgid "not enough meat"
msgstr "non hai carne abonda"

#: script/localization.js:60
msgid "not enough scales"
msgstr "non hai escamas abondas"

#: script/localization.js:57
msgid "not enough steel"
msgstr "non hai aceiro abondo"

#: script/localization.js:58
msgid "not enough sulphur"
msgstr "non hai xofre abondo"

#: script/localization.js:62
msgid "not enough teeth"
msgstr "non hai dentes abondos"

#: script/localization.js:54
msgid "not enough wood"
msgstr "non hai leña abonda"

#: script/room.js:1534
msgid "not enough wood to get the fire going"
msgstr "non hai leña abonda para manter prendido o lume"

#: script/events/outside.js:52
msgid "not far from the village lies a large beast, its fur matted with blood."
msgstr "non lonxe da aldea xace unha gran besta, ten a pel manchada de sangue."

#: script/events/setpieces.js:3736
msgid "not here. not yet. not until there is nowhere left to go and no reason not to know."
msgstr "non aquí. non aínda. non ata que non quede ningún lugar a onde ir e ningunha razón para non sabelo."

#: script/events/path.js:124
msgid "not long, they say. one of them says it twice, in the same tone, a minute apart."
msgstr "non moito, din. un deles dío dúas veces, no mesmo ton, cun minuto de diferenza."

#: script/events/setpieces.js:6282
msgid "not much here."
msgstr "pouca cousa por aquí."

#: script/ruins.js:56
msgid "not one of them can remember changing their mind, and not one of them finds that strange."
msgstr "ningún deles lembra ter cambiado de opinión, e a ningún deles lle parece estraño."

#: script/events/encounters.js:1795
msgid "not quieter. stopped. your own footfall, your own breathing, the wind that has not let up in three days."
msgstr "non máis silandeiro. parado. as túas propias pisadas, a túa propia respiración, o vento que non parou en tres días."

#: script/events/setpieces.js:2722
msgid "not somebody like you. you. the same hands. the same set to the jaw. the scar you have had as long as you can remember, already there on a body that has never been outside that glass."
msgstr "non alguén coma ti. ti. as mesmas mans. o mesmo xesto na queixada. a cicatriz que tes desde que tes memoria, xa alí nun corpo que nunca saíu de detrás dese vidro."

#: script/events/setpieces.js:3429
msgid "not two. six. the placements are exact and they are nowhere near each other, and three of them are at heights you cannot reach."
msgstr "non dous. seis. as colocacións son exactas e non están preto unhas das outras, e tres delas están a alturas que non alcanzas."

#: script/events/road.js:904
msgid "note where it is and move on"
msgstr "anotar onde está e seguir adiante"

#: script/lab.js:324
msgid "notes on the wall in ancient glyphs, in a small tidy hand."
msgstr "notas no muro en glifos ancestrais, cunha letra pequena e coidada."

#: script/events.js:1208
#: script/events/room.js:869
msgid "nothing"
msgstr "nada"

#: script/events/room.js:1421
msgid "nothing answered"
msgstr "nada respondeu"

#: script/events/room.js:1418
msgid "nothing answers back. nothing was ever going to."
msgstr "nada responde. nada ía facelo nunca."

#: script/events/setpieces.js:5269
msgid "nothing but downcast eyes."
msgstr "ollos caídos, máis nada."

#: script/events/path.js:248
msgid "nothing can be made of the ash"
msgstr "non se pode facer nada coa cinsa"

#: script/space.js:1071
msgid "nothing explains it. the ship goes on climbing and nothing comes after it."
msgstr "nada o explica. a nave segue ascendendo e nada a segue."

#: script/events/global.js:95
msgid "nothing goes missing again. his folk come in from the cold, and they work."
msgstr "nunca máis desaparece nada. a súa xente entra desde o frío, e traballan."

#: script/events/road.js:730
msgid "nothing grows within thirty paces of it. teeth ache at twenty."
msgstr "nada medra a menos de trinta pasos del. os dentes doen a vinte."

#: script/events/room.js:1729
msgid "nothing happens. it is the loudest nothing you have stood through in a long time."
msgstr "non pasa nada. é o nada máis ruidoso que aturaches en moito tempo."

#: script/events/encounters.js:1797
msgid "nothing happens. nothing is there. nothing comes."
msgstr "non pasa nada. non hai nada alí. nada vén."

#: script/engine.js:519
msgid "nothing has been changed. your current game is untouched."
msgstr "non se cambiou nada. a túa partida actual permanece intacta."

#: script/events/setpieces.js:1214
msgid "nothing has been in here at all"
msgstr "non entrou nada aquí en absoluto"

#: script/events/setpieces.js:1212
msgid "nothing has been in here. not dust, not damp, not anything, for a length of time the mind refuses."
msgstr "nada entrou aquí. nin po, nin humidade, nin nada, durante un tempo que a mente se nega a asimilar."

#: script/prison.js:244
msgid "nothing here gives you a straight line to fix on."
msgstr "nada aquí che dá unha liña recta na que fixarte."

#: script/events/road.js:380
msgid "nothing here was taken in a hurry. it was all set down and left."
msgstr "nada aquí se colleu con présa. todo se deixou pousado e abandonado."

#: script/events/setpieces.js:3341
msgid "nothing here will be."
msgstr "nada aquí o estará."

#: script/events/setpieces.js:3710
msgid "nothing in here is designed to stop a person leaving. all of it is designed to stop a person being HEARD."
msgstr "nada aquí está deseñado para impedir que unha persoa marche. todo está deseñado para impedir que a escoiten."

#: script/events/path.js:55
msgid "nothing is lost. nothing is gained. the flats look exactly the same afterwards."
msgstr "non se perde nada. non se gaña nada. as chairas quedan exactamente igual despois."

#: script/events/executioner.js:2315
msgid "nothing more here."
msgstr "nada máis aquí."

#: script/events.js:1273
msgid "nothing to take"
msgstr "non hai nada que coller"

#: script/events/setpieces.js:2080
msgid "nothing touches you. the air does. the doorway arrives very quickly and the road arrives after it."
msgstr "nada te toca. o aire si. o van da porta chega moi rápido e a estrada chega despois del."

#: script/events/outside.js:42
msgid "nothing was found"
msgstr "non se atopou nada"

#: script/events/road.js:1773
msgid "nothing weather does is perfect."
msgstr "nada do que fai o tempo é perfecto."

#: script/outside.js:878
msgid "noticing the builder staring is at you as if trying to figure something out."
msgstr "decatándose de que a construtora te mira fixamente coma se tentase entender algo."

#: script/room.js:321
msgid "now the nomads have a place to set up shop, they might stick around a while"
msgstr "agora que os nómadas teñen un lugar no que comerciar, seguramente queden por aquí"

#: script/prison.js:261
msgid "nullified sound. what prisoner would necessitate should a prison"
msgstr "son anulado. o que precisaría un prisioneiro se houbese un cárcere"

#: script/events/executioner.js:2456
msgid "observe"
msgstr "observar"

#: script/events/setpieces.js:2205
msgid "obsidian shell"
msgstr "cuncha de obsidiana"

#: script/events/setpieces.js:93
msgid "offer another charm"
msgstr "ofrecer outro amuleto"

#: script/events/setpieces.js:93
msgid "offer another charm anyway"
msgstr "ofrecer outro amuleto de todos os xeitos"

