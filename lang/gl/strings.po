msgstr "Unha Cabra Radiada"

#: script/events/encounters.js:349
msgid "a radiated goat charges with its mutated antlers"
msgstr "unha cabra radiada carga coas súas astas mutadas"

#: script/room.js:1659
msgid "a ragged stranger stumbles through the door and collapses in the corner"
msgstr "unha estraña piollosa cruza a porta a duras penas e desmáisae na esquina"

